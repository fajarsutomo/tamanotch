<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Glass: latar tembus pandang di atas blur desktop asli (GlassBackdrop). Kunci brush semantik yang sama di Colors.Dark/Light/Glass.xaml (dicek oleh ThemeTests). -->

    <!-- Permukaan -->
    <SolidColorBrush x:Key="ThemeSurfaceDeep" Color="#2E000000"/>
    <SolidColorBrush x:Key="ThemeSurface" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ThemeSurfaceRaised" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ThemeSurfaceHigh" Color="#4DFFFFFF"/>
    <!-- Garis -->
    <SolidColorBrush x:Key="ThemeLine" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ThemeLineStrong" Color="#66FFFFFF"/>
    <!-- Teks -->
    <SolidColorBrush x:Key="ThemeText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeTextBody" Color="#F0F0F2"/>
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#CDCDD3"/>
    <SolidColorBrush x:Key="ThemeTextMuted" Color="#A3A3AB"/>
    <!-- Island (notch) -->
    <SolidColorBrush x:Key="ThemeIslandBg" Color="#4D1C1C20"/>
    <!-- Kapsul idle dan notch notifikasi tanpa blur: hampir pekat agar tetap terbaca -->
    <SolidColorBrush x:Key="ThemeIslandIdleBg" Color="#E61C1C1F"/>

    <!-- Pil, lencana ikon, dan bingkai island -->
    <!-- Flat (Material): semua warna polos, tanpa gradien logam -->
    <SolidColorBrush x:Key="LuxuryNotchBorderBrush" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="LuxuryPillBackgroundBrush" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="MetallicIconBadgeBgBrush" Color="#24FFFFFF"/>
    <!-- Tepi kaca (specular rim): terang di atas, memudar, menyala tipis di bawah -->
    <LinearGradientBrush x:Key="MetallicIconBadgeBorderBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#B3FFFFFF" Offset="0.0"/>
        <GradientStop Color="#26FFFFFF" Offset="0.45"/>
        <GradientStop Color="#14FFFFFF" Offset="0.7"/>
        <GradientStop Color="#4DFFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NotchPillBorderBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Color="#99FFFFFF" Offset="0.0"/>
        <GradientStop Color="#1FFFFFFF" Offset="0.5"/>
        <GradientStop Color="#40FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="NotchPillHoverBorderBrush" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="NotchBadgeHoverBorderBrush" Color="#99FFFFFF"/>

    <!-- Warna isi ikon vektor (nama lama dipertahankan; kini polos) -->
    <SolidColorBrush x:Key="MetallicSilverBrush" Color="#FFFFFF"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollBar.Thumb.Normal" Color="#55FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb.MouseOver" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb.Pressed" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="ScrollBar.Track.Background" Color="#1F000000"/>
</ResourceDictionary>
