<UserControl x:Class="TamaNotch.Views.QuranPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:TamaNotch.Helpers"
             xmlns:helpers="clr-namespace:TamaNotch.Helpers"
             xmlns:views="clr-namespace:TamaNotch.Views"
             Foreground="{DynamicResource ThemeText}">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>


        <!-- Buku terbuka (24x24) -->

        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuranTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#686888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================= MODE 1: MINI ================= -->
        <Grid Visibility="{Binding IsQuranWindowCompact, Converter={StaticResource BoolToVis}}"
              Height="50" Margin="10,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="9" Margin="0,0,8,0"
                    Background="{DynamicResource ThemeSurface}" BorderBrush="#38FFFFFF" BorderThickness="1">
                <Path Data="{DynamicResource QuranIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}" Width="16" Height="16" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1.2"
                    CornerRadius="12" Height="34" Margin="0,0,8,0" Padding="10,2" Cursor="Hand"
                    ToolTip="{Binding QuranNotchTooltip}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ExpandQuranWindowCommand}"/>
                </Border.InputBindings>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#666677"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuranPlaying}" Value="True">
                                        <Setter Property="Fill" Value="#30D158"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsQuranLoading}" Value="True">
                                        <Setter Property="Fill" Value="#FFAA44"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Text="{Binding CurrentQuranTitle}" Foreground="{DynamicResource ThemeText}"
                               FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{DynamicResource WindowControlButton}" Height="34" MinWidth="34" Command="{Binding ToggleQuranPlayPauseCommand}"
                        ToolTip="Putar / Jeda">
                    <Grid>
                        <icons:IconPath Kind="ChevronRight" Width="12" Height="12" Visibility="{Binding IsQuranPlaying, Converter={StaticResource InverseBoolToVis}}"/>
                        <TextBlock Text="⏸" FontSize="10" Visibility="{Binding IsQuranPlaying, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Button>
                <Button Style="{DynamicResource WindowControlButton}" Height="34" MinWidth="34" Command="{Binding NextQuranCommand}" Content="⏭" ToolTip="Surah Berikutnya"/>
                <Button Style="{DynamicResource WindowControlButton}" Height="34" MinWidth="34" Command="{Binding RandomQuranCommand}" Content="{icons:Icon Shuffle}" ToolTip="Surah Acak"/>
                <Button Style="{DynamicResource WindowControlButton}" Height="34" MinWidth="34" Command="{Binding ExpandQuranWindowCommand}" Content="{icons:Icon ChevronDown}" ToolTip="Perluas"/>
                <Button Style="{DynamicResource WindowControlButton}" Height="34" MinWidth="34" Click="CloseButton_Click" Content="{icons:Icon Close}" ToolTip="Sembunyikan Jendela Al-Qur'an"/>
            </StackPanel>
        </Grid>

        <!-- ================= MODE 2: PEMUTAR LENGKAP ================= -->
        <Grid Visibility="{Binding IsQuranWindowExpanded, Converter={StaticResource BoolToVis}}" Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Surah aktif -->
                <RowDefinition Height="Auto"/> <!-- Pencarian -->
                <RowDefinition Height="Auto"/> <!-- Daftar surah -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource ThemeSurface}" BorderBrush="#38FFFFFF" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Path Data="{DynamicResource QuranIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}" Width="15" Height="15" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Al-Qur'an" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                            <Border CornerRadius="5" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsQuranPlaying}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsQuranLoading}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding QuranStateBadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding QuranStatusMessage}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{DynamicResource WindowControlButton}" Height="28" MinWidth="28" Command="{Binding MinimizeQuranWindowCommand}"
                            Content="{icons:Icon ChevronUp}" ToolTip="Perkecil ke Mini Player" Margin="0,0,3,0"/>
                    <Button Style="{DynamicResource WindowControlButton}" Height="28" MinWidth="28" Click="CloseButton_Click"
                            Content="{icons:Icon Close}" ToolTip="Sembunyikan Jendela Al-Qur'an (bacaan tetap berjalan di latar belakang)"/>
                </StackPanel>
            </Grid>

            <!-- SURAH AKTIF -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1.2"
                    CornerRadius="14" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="SURAH AKTIF" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CurrentQuranTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentQuranSubtitle}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentQuranArabic}" FontSize="24" Foreground="#E8D9A8"
                                   FlowDirection="RightToLeft" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Transport: sebelumnya, putar/jeda, stop, berikutnya, acak -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding PreviousQuranCommand}"
                                Width="38" Height="34" Padding="0" ToolTip="Surah Sebelumnya" Margin="0,0,6,0">
                            <Path Data="M 0 0 H 2.2 V 11 H 0 Z M 10 0 L 2.8 5.5 L 10 11 Z" Fill="{DynamicResource ThemeTextBody}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleQuranPlayPauseCommand}"
                                Width="48" Height="38" Padding="0" ToolTip="Putar / Jeda"
                                Background="#FFFFFF" BorderBrush="#FFFFFF" Margin="0,0,6,0">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M 0 0 L 12 7 L 0 14 Z" Fill="#000000" Margin="2,0,0,0"
                                      Visibility="{Binding IsQuranPlaying, Converter={StaticResource InverseBoolToVis}}"/>
                                <Path Data="M 0 0 H 3.8 V 13 H 0 Z M 6.8 0 H 10.6 V 13 H 6.8 Z" Fill="#000000"
                                      Visibility="{Binding IsQuranPlaying, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding StopQuranCommand}"
                                Width="38" Height="34" Padding="0" ToolTip="Hentikan" Margin="0,0,6,0">
                            <Rectangle Width="10" Height="10" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource ThemeTextBody}"/>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding NextQuranCommand}"
                                Width="38" Height="34" Padding="0" ToolTip="Surah Berikutnya" Margin="0,0,6,0">
                            <Path Data="M 0 0 L 7.2 5.5 L 0 11 Z M 7.8 0 H 10 V 11 H 7.8 Z" Fill="{DynamicResource ThemeTextBody}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding RandomQuranCommand}"
                                Width="38" Height="34" Padding="0" ToolTip="Putar surah acak" Margin="0">
                            <icons:IconPath Kind="Shuffle" Width="12" Height="12"/>
                        </Button>
                    </StackPanel>

                    <!-- Progres (klik untuk melompat) -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding QuranPositionText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10.5" VerticalAlignment="Center"/>
                        <ProgressBar x:Name="QuranProgressBar" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding QuranProgress, Mode=OneWay}"
                                     Height="6" BorderThickness="0" Background="{DynamicResource ThemeSurfaceRaised}" Foreground="#E8D9A8"
                                     Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown"/>
                        <TextBlock Grid.Column="2" Text="{Binding QuranDurationText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Volume -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="38"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SmallPillButton}" Command="{Binding ToggleQuranMuteCommand}"
                                Padding="6,2" Margin="0,0,8,0" ToolTip="Bisukan / Bunyikan Suara">
                            <TextBlock Text="{Binding QuranVolumeIcon}" FontSize="11"/>
                        </Button>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding QuranVolume, Mode=TwoWay}"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center" Cursor="Hand"/>
                        <TextBlock Grid.Column="2" Text="{Binding QuranVolumePercentText}" Foreground="{DynamicResource ThemeTextSecondary}"
                                   FontSize="10.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding CycleQuranAfterPlaybackCommand}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Padding="9,4"
                            ToolTip="Ganti: berhenti, surah berikutnya, atau surah acak">
                        <TextBlock Text="{Binding QuranAfterPlaybackText}" FontSize="10.5"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- PENCARIAN -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <TextBox x:Name="SearchQuranBox"
                         Text="{Binding QuranSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource QuranTextBoxStyle}" Padding="8,5,28,5"/>
                <TextBlock Text="Cari surah (nama, arti, nomor, atau Arab)..."
                           Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" IsHitTestVisible="False"
                           Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchQuranBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{DynamicResource SearchClearButton}" Tag="{Binding Text, ElementName=SearchQuranBox}"
                        icons:ClearTextButton.Target="{Binding ElementName=SearchQuranBox}"
                        Content="{icons:Icon Close}"/>
            </Grid>

            <!-- DAFTAR SURAH -->
            <Border Grid.Row="3" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1" CornerRadius="12" Padding="6,5" Height="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding FilteredQuranSurahs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="9" Padding="8,6" Margin="0,2" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.PlayQuranSurahCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                                    <Setter Property="BorderBrush" Value="#485880"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Margin="0,0,9,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Background" Value="#30D158"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBody}"
                                                           Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}}"/>
                                                <icons:IconPath Kind="MusicNote" Width="12" Height="12" Fill="#000000"
                                                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding NameSimple}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding NameArabic}" FontSize="16" Foreground="#E8D9A8"
                                                   FlowDirection="RightToLeft" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- FOOTER -->
            <TextBlock Grid.Row="4" Margin="2,8,2,0" HorizontalAlignment="Center"
                       Text="Murottal Mishari Alafasy • audio dari Quran.com (perlu internet)"
                       FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}"/>
        </Grid>
    </Grid>
</UserControl>
