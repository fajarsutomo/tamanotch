<Window x:Class="TamaNotch.Views.PrayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TamaNotch.Views"
        xmlns:icons="clr-namespace:TamaNotch.Helpers"
        xmlns:helpers="clr-namespace:TamaNotch.Helpers"
        Title="TAMANOTCH - Waktu Sholat"
        Width="360" MinWidth="300"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource ThemeText}"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">


    <Grid Margin="12">
        <Border x:Name="PrayerContainerBorder"
                Background="{DynamicResource ThemeSurfaceDeep}"
                BorderBrush="{DynamicResource ThemeLine}"
                BorderThickness="1.2"
                CornerRadius="20"
                MouseDown="Border_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="4" BlurRadius="16" Opacity="0.65"/>
            </Border.Effect>

            <views:PrayerPanel x:Name="Panel" CloseRequested="Panel_CloseRequested"/>
        </Border>
    </Grid>
</Window>
