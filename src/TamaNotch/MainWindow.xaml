<Window x:Class="TamaNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:TamaNotch.Helpers"
        xmlns:helpers="clr-namespace:TamaNotch.Helpers"
        xmlns:views="clr-namespace:TamaNotch.Views"
        Title="TAMANOTCH"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Loaded="Window_Loaded">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <!-- Quick Preset Deadline Button Style -->
        <Style x:Key="QuickPresetButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <helpers:BoolToStrikethroughConverter x:Key="BoolToStrike"/>
        <helpers:CountToVisibilityConverter x:Key="CountToVis"/>
        <helpers:CountToVisibilityConverter x:Key="InverseCountToVis" Invert="True"/>

        <!-- Luxury Specular Rim Border Brush for the Mac Notch -->

        <!-- Satin Pill Surface Brush -->

        <!-- Silver Metallic Gradient Brush (Matching TAMANOTCH Logo) -->

        <!-- Luxury Squircle Icon Badge Surface & Rim -->


        <!-- Luxury Vector Geometries (24x24 ViewBox) -->
        <!-- 1. Waktu Sholat: Crescent Moon & 4-Point Diamond Star -->

        <!-- 2. To-Do List: Luxury Rounded Task Frame & Bold Checkmark -->

        <!-- 3. Browser: Meridian Globe Lines -->

        <!-- 4. Modular Components Grid (4 Squares) -->

        <!-- 5. Music Eighth Note -->

        <!-- 6. Radio Online (Komponen ke-5): Luxury Radio Receiver & Antenna -->

        <!-- 6b. Live TV - Famelack (Komponen ke-6): Luxury TV Screen, Play Triangle & Dual Antenna -->

        <!-- 6c. Cuaca & Gempa Bumi BMKG (Komponen ke-7): Luxury Cloud & Seismic Pulse Wave -->

        <!-- Jellyfin: logo sederhana (segitiga dengan segitiga lubang) + gradasi ungu-biru -->
        <Geometry x:Key="JellyfinIconGeometry">F0 M12,2.5 L21.3,19.8 L2.7,19.8 Z M12,8.4 L16.2,16.6 L7.8,16.6 Z</Geometry>
        <LinearGradientBrush x:Key="JellyfinBrush" StartPoint="0.15,0" EndPoint="0.85,1">
            <GradientStop Color="#AA5CC3" Offset="0"/>
            <GradientStop Color="#00A4DC" Offset="1"/>
        </LinearGradientBrush>

        <!-- 7. Spotify Icon Geometry (24x24 ViewBox) -->
        <Geometry x:Key="SpotifyIconGeometry">M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 16.59,16.59 C 16.35,16.97 15.85,17.09 15.47,16.85 C 12.66,15.13 9.36,14.77 5.48,15.66 C 5.05,15.76 4.61,15.48 4.51,15.05 C 4.41,14.61 4.68,14.17 5.12,14.07 C 9.36,13.1 13.02,13.52 16.16,15.44 C 16.54,15.67 16.66,16.17 16.42,16.56 Z M 17.92,13.44 C 17.66,13.88 17.09,14.02 16.66,13.75 C 13.62,11.88 9.01,11.34 5.41,12.44 C 4.91,12.59 4.38,12.31 4.22,11.81 C 4.06,11.31 4.34,10.78 4.84,10.62 C 8.95,9.38 14.05,9.98 17.52,12.11 C 17.95,12.38 18.09,12.94 17.83,13.38 Z M 18.06,10.23 C 14.41,8.06 8.38,7.86 4.88,8.92 C 4.31,9.09 3.72,8.78 3.55,8.22 C 3.38,7.66 3.69,7.06 4.25,6.89 C 8.28,5.66 14.94,5.9 19.14,8.39 C 19.64,8.69 19.81,9.33 19.52,9.83 C 19.22,10.33 18.58,10.5 18.08,10.2 Z</Geometry>

        <!-- Button style for sleek media controls -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="14" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#48FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource LuxuryPillBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Margin" Value="2.5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="#565672"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="#404058"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Pill for To-Do -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom CheckBox for To-Do -->
        <Style x:Key="TodoCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="BoxBorder" Width="18" Height="18" CornerRadius="5"
                                Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1.2">
                            <Path x:Name="CheckMark" Data="M 3 8 L 7 12 L 14 4" Stroke="#000000" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BoxBorder" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Delete Button for To-Do Item -->
        <Style x:Key="TodoDeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DelBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DelBorder" Property="Background" Value="#33FF4D6D"/>
                                <Setter Property="Foreground" Value="#FF6B8B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox for To-Do -->
        <Style x:Key="TodoTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Category ComboBox Style -->
        <Style x:Key="DarkCategoryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLine}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Editable Text / Selected Value -->
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                             Background="Transparent" Foreground="{DynamicResource ThemeTextBody}"
                                             BorderThickness="0" Padding="6,3" VerticalAlignment="Center"
                                             FontSize="11" CaretBrush="#FFFFFF"/>

                                    <!-- Placeholder when empty -->
                                    <TextBlock Grid.Column="0" Text="Kategori &#x25BE;" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5"
                                               IsHitTestVisible="False" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_EditableTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Toggle Dropdown Button -->
                                    <ToggleButton Grid.Column="1" Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 3.5 3.5 L 7 0 Z" Fill="#888888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>

                            <!-- Popup Dropdown List -->
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1" CornerRadius="8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="160" Padding="3" Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
                        <Setter Property="Padding" Value="6,4"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseAppButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallPillButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Style untuk Badge 5 Ikon Notch saat Hover -->
        <Style x:Key="NotchIconBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MetallicIconBadgeBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MetallicIconBadgeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                    <Setter Property="BorderBrush" Value="{Binding HoverRingBrush, TargetNullValue={StaticResource NotchBadgeHoverBorderBrush}, FallbackValue={StaticResource NotchBadgeHoverBorderBrush}}"/>
                </Trigger>
                <!-- Penanda aktif (sedang memutar / jendela atau panel terbuka): bingkai hijau. Tag diisi tiap tombol. -->
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="#30D158"/>
                    <Setter Property="BorderThickness" Value="1.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style untuk Pill Waktu Sholat di Bawah saat Hover -->
        <Style x:Key="NotchPrayerPillStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NotchPillBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                    <Setter Property="BorderBrush" Value="{Binding HoverRingBrush, TargetNullValue={StaticResource NotchPillHoverBorderBrush}, FallbackValue={StaticResource NotchPillHoverBorderBrush}}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
            <!-- Tombol Panah Pindah Kategori Up / Down -->
                <!-- Tombol Chevron Expand / Collapse Kategori (▼ / ▶) -->
        <Style x:Key="CategoryChevronToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4">
                            <TextBlock x:Name="chevron" Text="▾" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="chevron" Property="Text" Value="▸"/>
                                <Setter TargetName="chevron" Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                <Setter TargetName="chevron" Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Expander Bersih Tanpa Header Bawaan OS -->
        <Style x:Key="CleanCategoryExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel Margin="0,3,0,6">
                            <ContentPresenter ContentSource="Header"/>
                            <Border x:Name="ExpandSite" Visibility="Collapsed">
                                <ContentPresenter/>
                            </Border>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryOrderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#555577"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3F3F5A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Main Outer Container Attached to Top Bezel with Mac-Style Concave Notch Ears & DropShadow -->
    <!-- Main Outer Container Attached to Top Bezel -->
    <Grid Margin="16,0,16,16" SnapsToDevicePixels="True" UseLayoutRounding="True">



        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="MainIslandBorder"
                Grid.Column="1"
                BorderThickness="1.2,0,1.2,1.2"
                MouseDown="Island_MouseDown">
            <Border.Style>
                <!-- Idle: kapsul menempel di atas dengan tepi neon (warna, ukuran, sudut dari Pengaturan); hover: island biasa (warna bawaan atau pilihan) -->
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource ThemeIslandBg}"/>
                    <Setter Property="BorderBrush" Value="{Binding HoverFrameBrush, TargetNullValue={StaticResource LuxuryNotchBorderBrush}, FallbackValue={StaticResource LuxuryNotchBorderBrush}}"/>
                    <Setter Property="CornerRadius" Value="0,0,22,22"/>
                    <Setter Property="Effect" Value="{Binding HoverGlowEffect}"/>
                    <Style.Triggers>
                        <!-- Saat tidak terbuka penuh (idle, notch notifikasi) tidak ada blur Glass: pakai latar idle -->
                        <DataTrigger Binding="{Binding ShowComponentIcons}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ThemeIslandIdleBg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ShowIdleEyes}" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding IdleFrameBrush}"/>
                            <Setter Property="CornerRadius" Value="{Binding IdleFrameCornerRadius}"/>
                            <Setter Property="Width" Value="{Binding IdleFrameWidth}"/>
                            <Setter Property="Height" Value="{Binding IdleFrameHeight}"/>
                            <Setter Property="Effect" Value="{Binding IdleGlowEffect}"/>
                        </DataTrigger>
                        <!-- Notch notifikasi (gempa besar / cuaca ekstrem): tinggi sama dengan idle, lebar mengikuti pesan, frame merah -->
                        <DataTrigger Binding="{Binding ShowAlertNotch}" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding AlertFrameBrush}"/>
                            <Setter Property="Width" Value="{Binding AlertNotchWidth}"/>
                            <Setter Property="Effect" Value="{Binding AlertGlowEffect}"/>
                        </DataTrigger>
                        <!-- Notch pengingat kesehatan: biru (minum) atau pink (gerak) -->
                        <DataTrigger Binding="{Binding ShowWellnessNotch}" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding WellnessFrameBrush}"/>
                            <Setter Property="Width" Value="{Binding AlertNotchWidth}"/>
                            <Setter Property="Effect" Value="{Binding WellnessGlowEffect}"/>
                        </DataTrigger>
                        <!-- Notch notifikasi sholat/adzan: sama seperti peringatan BMKG tetapi berframe hijau -->
                        <DataTrigger Binding="{Binding ShowPrayerNotch}" Value="True">
                            <Setter Property="BorderBrush" Value="{Binding PrayerFrameBrush}"/>
                            <Setter Property="Width" Value="{Binding AlertNotchWidth}"/>
                            <Setter Property="Effect" Value="{Binding PrayerGlowEffect}"/>
                        </DataTrigger>
                        <!-- Eksperimen: bentuk air menggantung (compact: idle, notch notifikasi, island hover); digambar oleh DropShapePath -->
                        <DataTrigger Binding="{Binding ShowDropShape}" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Effect" Value="{x:Null}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>



            <Border.ContextMenu>
                <ContextMenu Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1.2">
                    <MenuItem Header="Perluas Panel" Command="{Binding SetModeCommand}" CommandParameter="Expanded" 
                              Foreground="{DynamicResource ThemeText}" Visibility="{Binding IsCompactMode, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="Perkecil ke Notch" Command="{Binding SetModeCommand}" CommandParameter="Compact"
                              Foreground="{DynamicResource ThemeText}" Visibility="{Binding IsExpandedMode, Converter={StaticResource BoolToVis}}"/>
                    <MenuItem Header="{Binding PinMenuText}" Command="{Binding TogglePinCommand}" Foreground="{DynamicResource ThemeText}"/>
                    <MenuItem Header="Pengaturan" Command="{Binding OpenSettingsCommand}" Foreground="{DynamicResource ThemeText}"/>
                    <Separator Background="{DynamicResource ThemeSurfaceRaised}"/>
                    <MenuItem Header="Tutup / Keluar Aplikasi" Command="{Binding ExitApplicationCommand}" Foreground="#FF6666"/>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <!-- Bentuk tetes air (idle, eksperimen). Koordinat 0..1 agar ukuran alaminya diabaikan saat ukuran otomatis. -->
                <!-- Canvas tidak ikut menentukan ukuran kapsul; melebar DropEarRadius ke kiri/kanan untuk lengkung terbalik di atas.
                     Geometri dibangun di MainWindow.UpdateDropShape dari ukuran kapsul + radius sudut bawah. -->
                <Canvas x:Name="DropCanvas" IsHitTestVisible="False" Margin="-16,0,-16,0"
                        Visibility="{Binding ShowDropShape, Converter={StaticResource BoolToVis}}">
                    <Path x:Name="DropShapePath" Fill="{DynamicResource ThemeIslandIdleBg}"
                          Stroke="{Binding DropFrameBrush, TargetNullValue={StaticResource LuxuryNotchBorderBrush}, FallbackValue={StaticResource LuxuryNotchBorderBrush}}"
                          StrokeThickness="1.2" StrokeLineJoin="Round">
                        <Path.Style>
                            <!-- Glow lewat style (bukan nilai lokal) agar bisa dilepas selama animasi lalu dipulihkan lewat ClearValue -->
                            <Style TargetType="Path">
                                <Setter Property="Effect" Value="{Binding DropGlowEffect}"/>
                            </Style>
                        </Path.Style>
                    </Path>
                </Canvas>
                <!-- ================= MODE 1: COMPACT (DYNAMIC ISLAND NOTCH: 5 KOMPONEN HOVER) ================= -->
                <!-- Saat idle: Hanya logo TAMANOTCH yang muncul. Saat dihover: 5 ikon komponen muncul ke kiri (musik, radio), kanan (todo, browser), dan bawah (waktu sholat) -->
                <Grid x:Name="CompactView" Grid.Row="0" Visibility="{Binding ShowCompactView, Converter={StaticResource BoolToVis}}" 
                      Margin="{Binding CompactViewMargin}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <!-- Baris 0: Logo TAMANOTCH di tengah, Musik & Radio di kiri, To-Do & Browser di kanan -->
                        <RowDefinition Height="Auto"/>
                        <!-- Baris 1: panel tertanam (opsional) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Baris 2: Waktu Sholat di bawah -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- BARIS 0: HORIZONTAL COMPONENT ROW DENGAN LOGO DI TENGAH -->
                    <Grid x:Name="IslandTopRow" Grid.Row="0" Grid.IsSharedSizeScope="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- Kolom 0: Komponen Kiri (Musik & Radio) -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Kolom 1: Logo TAMANOTCH (Pusat / Tengah) -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Kolom 2: Komponen Kanan (Browser & To-Do List) -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- SISI KIRI: KOMPONEN 1 (MUSIK LENGKAP DI PALING KIRI) & KOMPONEN 2 (RADIO ONLINE) (Muncul saat Hover) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    >
                            <!-- 1. Pemutar Musik Lengkap (Di Paling Kiri: Album Art, Judul & Artis, Lirik Standby, Play/Pause, & Tombol YT Music) -->
                            <Border Style="{StaticResource NotchPrayerPillStyle}" Height="44" Margin="2,0,6,0" Padding="6,3,8,3"
                                    Visibility="{Binding ShowMusicPillInNotch, Converter={StaticResource BoolToVis}}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Album Art / Ikon Musik Squircle (Klik untuk perluas pemutar musik & lirik) -->
                                    <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True" Cursor="Hand"
                                            Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="#36FFFFFF" BorderThickness="1"
                                            ToolTip="{Binding MusicNotchTooltip}">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenMusicWindowCommand}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <Path Data="{DynamicResource LuxuryMusicNoteGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Visibility="{Binding HasTrackThumbnail, Converter={StaticResource InverseBoolToVis}}"/>
                                            <Image Source="{Binding CurrentTrack.Thumbnail}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Visibility="{Binding HasTrackThumbnail, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Judul Lagu, Artis & Lirik Real-Time Saat Standby (Klik untuk perluas pemutar musik & lirik) -->
                                    <StackPanel VerticalAlignment="Center" Margin="8,0,6,0" Width="135" Cursor="Hand"
                                                Background="Transparent"
                                                ToolTip="{Binding MusicNotchTooltip}">
                                        <StackPanel.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenMusicWindowCommand}"/>
                                        </StackPanel.InputBindings>
                                        <!-- Baris 1: Judul dan Artis -->
                                        <DockPanel LastChildFill="True">
                                            <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue=''}" 
                                                       Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Right" 
                                                       VerticalAlignment="Center" Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='TAMANOTCH'}" 
                                                       Foreground="{DynamicResource ThemeText}" FontWeight="Bold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <!-- Baris 2: Lirik Real-Time Saat Standby -->
                                        <Grid Margin="0,1,0,0" ToolTip="{Binding StandbyLyric}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Grid.Column="0" Data="{DynamicResource LuxuryMusicNoteGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                                  Width="9.5" Height="9.5" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding StandbyLyric, FallbackValue='Siap memutar...'}" 
                                                       Foreground="{DynamicResource ThemeTextBody}" FontSize="11.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Tombol Play / Pause -->
                                    <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding TogglePlayPauseCommand}" 
                                            Width="32" Height="32" Padding="0" Margin="0,0,4,0" ToolTip="Putar / Jeda" VerticalAlignment="Center">
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource MetallicIconBadgeBgBrush}" BorderBrush="{DynamicResource MetallicIconBadgeBorderBrush}" BorderThickness="1">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Play icon (when paused) -->
                                                <Path Data="M 0 0 L 10 6 L 0 12 Z" Fill="{DynamicResource MetallicSilverBrush}" Margin="2,0,0,0"
                                                      Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible, TargetNullValue=Visible}"/>
                                                <!-- Pause icon (when playing) -->
                                                <Path Data="M 0 0 H 3 V 11 H 0 Z M 5.5 0 H 8.5 V 11 H 5.5 Z" Fill="{DynamicResource MetallicSilverBrush}"
                                                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <!-- Tombol YT Music di dalam Komponen Musik (Icon Saja - Ukuran Presisi) -->
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenYouTubeMusicCommand}"
                                            ToolTip="Buka Pemutar YouTube Music" Width="26" Height="26" Padding="0" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Fill="#FF0033" Width="14" Height="14"/>
                                            <Path Data="M 0,0 L 5.5,3.5 L 0,7 Z" Fill="{DynamicResource ThemeText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                        </Grid>
                                    </Button>

                                    <!-- Tombol Spotify di dalam Komponen Musik (Icon Saja - Ukuran Presisi) -->
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSpotifyCommand}"
                                            ToolTip="Buka Pemutar Spotify" Width="26" Height="26" Padding="0" Margin="0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource SpotifyIconGeometry}" Fill="#1DB954" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
<Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenJellyfinCommand}"
                                            ToolTip="Buka Pemutar Jellyfin (myFlix)" Width="26" Height="26" Padding="0" Margin="0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource JellyfinIconGeometry}" Fill="{StaticResource JellyfinBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 1b. Tombol Ikon Musik Saja (Muncul saat Pemutar Musik dalam Mode Pelebaran / Pelepasan) -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="True" Margin="2,0,6,0" Cursor="Hand"
                                    Visibility="{Binding ShowMusicIconInNotch, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Pemutar Musik sedang dibuka (Klik untuk satukan kembali ke notch utama)">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseMusicWindowCommand}"/>
                                </Border.InputBindings>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource LuxuryMusicNoteGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 2. Radio Online -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="{Binding IsRadioPlaying}" Margin="2,0,6,0" Cursor="Hand"
                                    Visibility="{Binding ShowComponentIcons, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding RadioNotchTooltip}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenRadioCommand}"/>
                                </Border.InputBindings>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource LuxuryRadioIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 2b. Live TV (Famelack) -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="{Binding IsLiveTvActiveOrOpen}" Margin="0,0,6,0" Cursor="Hand"
                                    Visibility="{Binding ShowComponentIcons, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding LiveTvNotchTooltip}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenLiveTvCommand}"/>
                                </Border.InputBindings>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource LuxuryLiveTvIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 2c. Al-Qur'an (murottal per surah) -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="{Binding IsQuranPlaying}" Margin="0,0,6,0" Cursor="Hand"
                                    Visibility="{Binding ShowComponentIcons, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding QuranNotchTooltip}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenQuranCommand}"/>
                                </Border.InputBindings>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource QuranIconGeometry}"
                                          Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 2d. Pemakaian Claude (kuota sesi 5 jam / mingguan) -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="{Binding EnableClaudeUsage}" Margin="0,0,6,0" Cursor="Hand"
                                    Visibility="{Binding ShowComponentIcons, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Pemakaian Claude (kuota 5 jam / 7 hari)">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenClaudeUsageCommand}"/>
                                </Border.InputBindings>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource ClaudeUsageIconGeometry}"
                                          Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 2e. Sticky note (akun SAP, catatan) - tampil sebagai panel di island -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="{Binding IsNotesPanelOpen}" Margin="0,0,6,0" Cursor="Hand"
                                    Visibility="{Binding ShowNotesBadge, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Sticky note (akun dan catatan)">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenNotesCommand}"/>
                                </Border.InputBindings>
                                <icons:IconPath Kind="StickyNote" Width="18" Height="18" Fill="{DynamicResource MetallicSilverBrush}"/>
                            </Border>

                            <!-- 2f. Monitor sistem (CPU, memori, disk, jaringan, GPU) - panel di island -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="{Binding IsMonitorPanelOpen}" Margin="0,0,6,0" Cursor="Hand"
                                    Visibility="{Binding ShowMonitorBadge, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Monitor sistem (CPU, memori, disk, jaringan, GPU)">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenMonitorCommand}"/>
                                </Border.InputBindings>
                                <icons:IconPath Kind="Memory" Width="18" Height="18" Fill="{DynamicResource MetallicSilverBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- TENGAH: Mata menyala (hanya saat idle; saat hover slot ini hilang). Klik membuka Pengaturan. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding ShowEyesInIdle, Converter={StaticResource BoolToVis}}">
                            <Border Width="{Binding CenterIconWidth}" Height="{Binding CenterIconHeight}" Margin="2,0,2,0" Cursor="Hand"
                                    Background="Transparent" ToolTip="TAMANOTCH (Klik untuk membuka Pengaturan)">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSettingsCommand}"/>
                                </Border.InputBindings>
                                <views:NotchEyes HorizontalAlignment="Center" VerticalAlignment="Center"
                                                 Width="{Binding CenterIconWidth}" Height="{Binding CenterIconHeight}"
                                                 EyeColor="{Binding IdleEyeColor}"/>
                            </Border>
                        </StackPanel>


                        <!-- TENGAH (alternatif): pesan peringatan BMKG satu baris menggantikan mata. Klik membuka detail. -->
                        <Border Grid.Column="1" Visibility="{Binding ShowAlertNotch, Converter={StaticResource BoolToVis}}"
                                VerticalAlignment="Center" Margin="6,0" Cursor="Hand" Background="Transparent"
                                ToolTip="{Binding AlertNotchText}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenBmkgNotificationDetailCommand}"/>
                            </Border.InputBindings>
                            <TextBlock Text="{Binding AlertNotchText}" Foreground="{DynamicResource ThemeText}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="{Binding AlertNotchMaxTextWidth}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- TENGAH (alternatif): pesan sholat/adzan satu baris. Klik menutup notifikasi. -->
                        <Border Grid.Column="1" Visibility="{Binding ShowPrayerNotch, Converter={StaticResource BoolToVis}}"
                                VerticalAlignment="Center" Margin="6,0" Cursor="Hand" Background="Transparent"
                                ToolTip="{Binding PrayerNotchText}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding DismissPrayerNotificationCommand}"/>
                            </Border.InputBindings>
                            <TextBlock Text="{Binding PrayerNotchText}" Foreground="{DynamicResource ThemeText}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="{Binding AlertNotchMaxTextWidth}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- TENGAH (alternatif): pengingat minum/gerak satu baris. Klik = aksi utama; klik kanan = tunda/tutup. -->
                        <Border Grid.Column="1" Visibility="{Binding ShowWellnessNotch, Converter={StaticResource BoolToVis}}"
                                VerticalAlignment="Center" Margin="6,0" Cursor="Hand" Background="Transparent"
                                ToolTip="{Binding WellnessNotchTooltip}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding WellnessPrimaryActionCommand}"/>
                            </Border.InputBindings>
                            <Border.ContextMenu>
                                <ContextMenu Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1.2">
                                    <MenuItem Header="Tunda 10 menit" Command="{Binding WellnessSnoozeCommand}" Foreground="{DynamicResource ThemeText}"/>
                                    <MenuItem Header="Tutup" Command="{Binding DismissWellnessNotificationCommand}" Foreground="{DynamicResource ThemeText}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <TextBlock Text="{Binding WellnessNotchText}" Foreground="{DynamicResource ThemeText}" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" MaxWidth="{Binding AlertNotchMaxTextWidth}"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- SISI KANAN: KOMPONEN 4 (BROWSER), KOMPONEN BMKG, & KOMPONEN 5 (TO-DO LIST LENGKAP DI PALING KANAN) (Muncul saat Hover) -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="{Binding ShowComponentIcons, Converter={StaticResource BoolToVis}}"
                                    >
                            <!-- 4. Browser Mengambang (Di sebelah kanan Logo TAMANOTCH) -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="{Binding IsBrowserWindowOpen}" Margin="6,0,2,0" Cursor="Hand"
                                    ToolTip="Buka Browser Mengambang (YouTube, Streaming Film, Web Bebas)">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenFloatingBrowserCommand}"/>
                                </Border.InputBindings>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource LuxuryBrowserIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 4b. Cuaca & Gempa Bumi BMKG (Komponen ke-7) -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="{Binding IsBmkgWindowOpen}" Margin="4,0,2,0" Cursor="Hand"
                                    Visibility="{Binding EnableBmkg, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding BmkgNotchTooltip}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenBmkgCommand}"/>
                                </Border.InputBindings>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource LuxuryBmkgIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- 5. To-Do List Lengkap (Di Bagian Paling Sebelah Kanan: Quick Complete, Badge Jumlah, & Live Ticker) -->
                            <!-- 5b. Tombol Ikon To-Do List Saja (Muncul saat To-Do List dalam Mode Pelebaran / Pelepasan) -->
                            <Border Width="42" Height="42" Style="{StaticResource NotchIconBadgeStyle}" Tag="True" Margin="6,0,2,0" Cursor="Hand"
                                    Visibility="{Binding IsTodoDetachedWindowVisible, Converter={StaticResource BoolToVis}}"
                                    ToolTip="To-Do List sedang dibuka (Klik untuk satukan kembali ke notch utama)">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding AttachTodoCommand}"/>
                                </Border.InputBindings>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource LuxuryTodoIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource NotchPrayerPillStyle}" Height="44" Margin="6,0,2,0" Padding="8,4,10,4" Cursor="Hand"
                                    Visibility="{Binding IsTodoDetachedWindowVisible, Converter={StaticResource InverseBoolToVis}}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding CurrentTickerText, StringFormat='To-Do: {0} (Klik untuk buka daftar tugas)'}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenTodoCommand}"/>
                                </Border.InputBindings>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Tombol Cepat Selesai jika ada tugas tertunda -->
                                    <Button Grid.Column="0" Command="{Binding CompleteCurrentTickerCommand}"
                                            ToolTip="Tandai tugas pertama selesai" Style="{StaticResource ControlButtonStyle}"
                                            Padding="0" Width="30" Height="30" VerticalAlignment="Center"
                                            Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource MetallicIconBadgeBgBrush}"
                                                BorderBrush="{DynamicResource MetallicIconBadgeBorderBrush}" BorderThickness="1">
                                            <Path Data="{DynamicResource LuxuryTodoIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                                  Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>

                                    <!-- Ikon Luxury To-Do jika tidak ada tugas tertunda -->
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource MetallicIconBadgeBgBrush}"
                                            BorderBrush="{DynamicResource MetallicIconBadgeBorderBrush}" BorderThickness="1" VerticalAlignment="Center"
                                            Visibility="{Binding HasPendingTodos, Converter={StaticResource InverseBoolToVis}}">
                                        <Path Data="{DynamicResource LuxuryTodoIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                              Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Detail Tugas: Badge Jumlah Tugas + Marquee Live Ticker -->
                                    <Grid Grid.Column="1" Margin="8,0,2,0" Width="225" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Badge Jumlah Tugas (misal 3) -->
                                        <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1" CornerRadius="6" Padding="5,1.5" Margin="0,0,6,0"
                                                VerticalAlignment="Center" Visibility="{Binding HasPendingTodos, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding CurrentTickerBadge}" Foreground="{DynamicResource ThemeTextBody}" FontSize="11" FontWeight="Bold"/>
                                        </Border>

                                        <!-- Teks Judul Tugas yang Berjalan dari Kanan ke Kiri -->
                                        <helpers:MarqueeTextBlock Grid.Column="1" Text="{Binding CurrentTickerText}" 
                                                                  Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="SemiBold"
                                                                  Speed="36" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- PANEL TERTANAM: Radio, Al-Qur'an, Sholat, Claude (opsi "tampil di island") di antara tombol dan baris info -->
                    <Border x:Name="EmbeddedPanelHost" Grid.Row="1" Width="410" Margin="0,8,0,0"
                            HorizontalAlignment="Center" CornerRadius="16" ClipToBounds="True"
                            Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1"
                            Visibility="{Binding ShowEmbeddedPanel, Converter={StaticResource BoolToVis}}"/>

                    <!-- BARIS 1: SEJAJAR WAKTU SHOLAT (Sebelah Kiri: Pengaturan | Tengah: Waktu Sholat | Sebelah Kanan: Versi) -->
                    <Grid x:Name="IslandInfoRow" Grid.Row="2" Grid.IsSharedSizeScope="True" Margin="0,6,0,2"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="{Binding ShowComponentIcons, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sebelah Kiri: Tombol Pengaturan -->
                        <Border Grid.Column="0" Style="{StaticResource NotchPrayerPillStyle}"
                                Visibility="{Binding ShowComponentIcons, Converter={StaticResource BoolToVis}}"
                                Width="30" Height="30" Margin="0,0,6,0" Padding="0" Cursor="Hand"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                ToolTip="Pengaturan TAMANOTCH">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenSettingsCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <icons:IconPath Kind="Settings" Width="12" Height="12" Fill="{DynamicResource ThemeTextBody}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            </StackPanel>
                        </Border>

                        <!-- Tengah: Komponen 3 (Waktu Sholat) & Komponen BMKG (Cuaca + Gempa) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Style="{StaticResource NotchPrayerPillStyle}" Visibility="{Binding EnablePrayerTimes, Converter={StaticResource BoolToVis}}"
                                    Height="30" Padding="8,2,10,2" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="{Binding PrayerScheduleTooltip}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenPrayerScheduleCommand}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Ikon Bulan Sabit & Bintang Luxury -->
                                    <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource MetallicIconBadgeBgBrush}"
                                            BorderBrush="{DynamicResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource LuxuryPrayerIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                              Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Nama Sholat Berikutnya -->
                                    <TextBlock Text="{Binding NextPrayerName}" Foreground="{DynamicResource ThemeText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <!-- Waktu / Jam Sholat -->
                                    <TextBlock Text="{Binding NextPrayerTimeFormatted}" Foreground="{DynamicResource ThemeTextBody}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <!-- Badge Hitung Mundur Sholat -->
                                    <Border Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NextPrayerCountdownBadge}" Foreground="#30D158" FontSize="10.5" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Pill Cuaca & Gempa BMKG saat Hover -->
                            <Border Style="{StaticResource NotchPrayerPillStyle}" Visibility="{Binding ShowHoverWeatherPill, Converter={StaticResource BoolToVis}}"
                                    Height="30" Margin="6,0,0,0" Padding="8,2,10,2" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="{Binding BmkgNotchTooltip}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenBmkgCommand}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource MetallicIconBadgeBgBrush}"
                                            BorderBrush="{DynamicResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Path Data="{Binding BmkgWeatherIconGeometry}"
                                              Stroke="{Binding BmkgWeatherIconColor, FallbackValue=#FFD43B}"
                                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                              Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding BmkgWeatherTempText}" Foreground="{DynamicResource ThemeText}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding BmkgWeatherCityText}" Foreground="{DynamicResource ThemeTextBody}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="{Binding AirQualityBrush}" BorderThickness="1" CornerRadius="5"
                                            Padding="5,1" Margin="0,0,5,0" VerticalAlignment="Center"
                                            Visibility="{Binding ShowAirQualityBadge, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding AirQualityTooltip}">
                                        <TextBlock Text="{Binding AirQualityBadgeText}" Foreground="{Binding AirQualityBrush}"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <Border Background="{Binding LatestEarthquake.MagnitudeBadgeBackground, FallbackValue=#222230}"
                                            BorderBrush="{Binding LatestEarthquake.MagnitudeBadgeBorder, FallbackValue=#36364A}"
                                            BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center"
                                            Visibility="{Binding ShowIslandEarthquakeBadge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding LatestEarthquakeBadge}"
                                                   Foreground="{Binding LatestEarthquake.MagnitudeBadgeForeground, FallbackValue=#FFB74D}"
                                                   FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Pill Pemakaian Claude (kuota sesi 5 jam / mingguan 7 hari) -->
                            <Border Style="{StaticResource NotchPrayerPillStyle}" Visibility="{Binding ShowClaudeUsageBadge, Converter={StaticResource BoolToVis}}"
                                    Height="30" Margin="6,0,0,0" Padding="9,2,10,2" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="{Binding ClaudeBadgeTooltip}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenClaudeUsageCommand}"/>
                                </Border.InputBindings>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource ClaudeUsageIconGeometry}"
                                          Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ClaudeBadgeSessionText}" Foreground="{Binding ClaudeBadgeSessionBrush}"
                                               FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"
                                               Visibility="{Binding HasClaudeBadgeSession, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="&#x00B7;" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11.5" Margin="6,0,6,0" VerticalAlignment="Center"
                                               Visibility="{Binding HasClaudeBadgeWeek, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding ClaudeBadgeWeekText}" Foreground="{Binding ClaudeBadgeWeekBrush}"
                                               FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"
                                               Visibility="{Binding HasClaudeBadgeWeek, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Pill uptime komputer (sejak Windows menyala) -->
                            <Border Style="{StaticResource NotchPrayerPillStyle}" Visibility="{Binding ShowUptimePill, Converter={StaticResource BoolToVis}}"
                                    Height="30" Margin="6,0,0,0" Padding="9,2,10,2" Cursor="Hand"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    ToolTip="{Binding UptimeToolTip}">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenMonitorCommand}"/>
                                </Border.InputBindings>
                                <TextBlock Text="{Binding UptimeText}" Foreground="{Binding UptimeBrush}"
                                           FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Sebelah Kanan: Tombol Versi -->
                        <Border Grid.Column="2" Style="{StaticResource NotchPrayerPillStyle}"
                                Visibility="{Binding ShowComponentIcons, Converter={StaticResource BoolToVis}}"
                                Height="30" Margin="6,0,0,0" Padding="10,2" Cursor="Hand"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                ToolTip="{Binding VersionButtonTooltip}">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenUpdateCommand}"/>
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#x2B06;" Foreground="#30D158" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"
                                           Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding VersionButtonText}" Foreground="{DynamicResource ThemeTextBody}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                    <!-- ================= MODE 2: EXPANDED (SIDE-BY-SIDE: MUSIC & TO-DO) ================= -->
                <Grid x:Name="ExpandedView" Visibility="{Binding IsExpandedMode, Converter={StaticResource BoolToVis}}" 
                      Width="{Binding ExpandedPanelWidth}" Margin="22,16,22,18">

                    <!-- TAMPILAN NORMAL (MUSIK, WAKTU SHOLAT, & TO-DO) -->
                    <Grid Visibility="{Binding ShowNormalExpandedContent, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <!-- Kolom 0: Pemutar Musik -->
                            <ColumnDefinition Width="{Binding MusicColumnWidth}"/>
                            <!-- Garis Pemisah Vertikal 1: Musik | Waktu Sholat -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Kolom 2: Waktu Sholat (Expanded) -->
                            <ColumnDefinition Width="{Binding PrayerColumnWidth}"/>
                            <!-- Garis Pemisah Vertikal 2: Waktu Sholat | To-Do -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Kolom 4: To-Do List -->
                            <ColumnDefinition Width="{Binding TodoColumnWidth}"/>
                        </Grid.ColumnDefinitions>

                    <!-- ===== SISI KIRI: PEMUTAR MUSIK ===== -->
                    <Grid Grid.Column="0" Visibility="{Binding ShowMusicSection, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header & Session info & Tools -->
                        <Grid Grid.Row="0" Margin="0,0,6,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Album art / Icon TAMANOTCH (Luxury Mac Squircle) -->
                            <Border Grid.Column="0" Width="50" Height="50" CornerRadius="13" ClipToBounds="True" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="#36FFFFFF" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Grid>
                                    <Path Data="{DynamicResource LuxuryMusicNoteGeometry}" Fill="{DynamicResource MetallicSilverBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding CurrentTrack.Thumbnail}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <!-- Track Title, Artist, Session -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='Tidak ada lagu'}" 
                                           Foreground="{DynamicResource ThemeText}" FontSize="15.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='-'}" 
                                           Foreground="{DynamicResource ThemeTextBody}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                <TextBlock Text="{Binding SessionStatus}" 
                                           Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>

                            <!-- Top actions (Update, YouTube Music, Minimize, Close) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SmallPillButton}" 
                                        Command="{Binding OpenUpdateCommand}" 
                                        Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}" 
                                        ToolTip="Versi baru tersedia! Klik untuk memperbarui TAMANOTCH" 
                                        Background="{DynamicResource ThemeSurfaceRaised}" Padding="6,3" Margin="0,0,3,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2728;" FontSize="10" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding VersionButtonText}" 
                                                   Foreground="{DynamicResource ThemeText}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleVocalRemoverCommand}"
                                        ToolTip="{Binding VocalRemoverTooltip}" Padding="6,3" Margin="0,0,3,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F3A4;" FontSize="10" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="Karaoke" FontSize="11" Foreground="{DynamicResource ThemeTextBody}" VerticalAlignment="Center"/>
                                        <Ellipse Width="6" Height="6" Fill="#30D158" Margin="4,0,0,0" VerticalAlignment="Center"
                                                 Visibility="{Binding IsVocalRemoverEnabled, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenYouTubeMusicCommand}" 
                                        ToolTip="Buka Pemutar YouTube Music" Width="26" Height="26" Padding="0" Margin="0,0,3,0">
                                    <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Fill="#FF0033" Width="14" Height="14"/>
                                        <Path Data="M 0,0 L 5.5,3.5 L 0,7 Z" Fill="{DynamicResource ThemeText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSpotifyCommand}" 
                                        ToolTip="Buka Pemutar Spotify" Width="26" Height="26" Padding="0" Margin="0,0,3,0">
                                    <Path Data="{StaticResource SpotifyIconGeometry}" Fill="#1DB954" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
<Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenJellyfinCommand}" 
                                        ToolTip="Buka Pemutar Jellyfin (myFlix)" Width="26" Height="26" Padding="0" Margin="0,0,3,0">
                                    <Path Data="{StaticResource JellyfinIconGeometry}" Fill="{StaticResource JellyfinBrush}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Compact" Content="{icons:Icon Dock}" ToolTip="Menyatu kembali dengan notch utama" Padding="7,3" Margin="0"/>



                            </StackPanel>
                        </Grid>

                        <!-- Synced 3-Line Lyrics Preview / Unsynced Scrollable Lyrics / YT Music Button State -->
                        <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="10" Padding="10,8" Margin="0,4,0,8"
                                MinHeight="68" MaxHeight="96">
                            <Grid>
                                <!-- State 1: Tidak ada lagu yang diputar -> Tombol YT Music -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding HasTrack, Converter={StaticResource InverseBoolToVis}}">
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenYouTubeMusicCommand}"
                                            ToolTip="Buka Pemutar YouTube Music" Background="{DynamicResource ThemeSurface}" BorderBrush="#4A2534" BorderThickness="1.2"
                                            Width="38" Height="38" Padding="0" Margin="0,0,8,0" Cursor="Hand">
                                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Fill="#FF0033" Width="20" Height="20"/>
                                            <Path Data="M 0,0 L 7.5,5 L 0,10 Z" Fill="{DynamicResource ThemeText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1.5,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSpotifyCommand}"
                                            ToolTip="Buka Pemutar Spotify" Background="{DynamicResource ThemeSurface}" BorderBrush="#254A32" BorderThickness="1.2"
                                            Width="38" Height="38" Padding="0" Cursor="Hand">
                                        <Path Data="{StaticResource SpotifyIconGeometry}" Fill="#1DB954" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
<Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenJellyfinCommand}"
                                            ToolTip="Buka Pemutar Jellyfin (myFlix)" Background="{DynamicResource ThemeSurface}" BorderBrush="#3A2F5C" BorderThickness="1.2"
                                            Width="38" Height="38" Padding="0" Cursor="Hand">
                                        <Path Data="{StaticResource JellyfinIconGeometry}" Fill="{StaticResource JellyfinBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>

                                <!-- State 2: Ada lagu yang diputar -> Tampilkan Lirik -->
                                <Grid Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                                    <!-- Synced 3-Line Display -->
                                    <StackPanel VerticalAlignment="Center"
                                                Visibility="{Binding IsLyricsSynced, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding PreviousLyric}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding ActiveLyric}" Foreground="{DynamicResource ThemeText}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,2"/>
                                        <TextBlock Text="{Binding NextLyric}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="12" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Unsynced / Plain Lyrics Display with ScrollViewer -->
                                    <ScrollViewer VerticalAlignment="Center" MaxHeight="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  Visibility="{Binding IsLyricsSynced, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="{Binding ActiveLyric}" Foreground="{DynamicResource ThemeTextBody}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" LineHeight="18"/>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Progress bar & time -->
                        <Grid Grid.Row="2" Margin="0,2,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Slider Grid.Row="0" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding CurrentPositionSeconds, Mode=TwoWay}"
                                    IsMoveToPointEnabled="True" Cursor="Hand" Margin="0,0,0,2"
                                    PreviewMouseDown="ProgressBar_PreviewMouseDown" PreviewMouseUp="ProgressBar_PreviewMouseUp"/>
                            <Grid Grid.Row="1">
                                <TextBlock Text="{Binding FormattedTime}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding CurrentLyrics.Source, StringFormat='Sumber: {0}'}" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" HorizontalAlignment="Left"/>
                            </Grid>
                        </Grid>

                        <!-- Satu Baris: Tombol Offset (Kiri), Control Play (Tengah), dan Import File (Kanan) -->
                        <Grid Grid.Row="3" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Kiri: Offset controls -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Offset:" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetSubtractCommand}" Content="-0.5s" FontSize="10.5" Padding="6,3" Margin="1,0" ToolTip="Lirik terlambat (geser mundur)"/>
                                <TextBlock Text="{Binding ManualOffsetSeconds, StringFormat='{}{0:0.0}s'}" Foreground="{DynamicResource ThemeText}" FontSize="10.5" VerticalAlignment="Center" Margin="3,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetAddCommand}" Content="+0.5s" FontSize="10.5" Padding="6,3" Margin="1,0" ToolTip="Lirik terlalu cepat (geser maju)"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetResetCommand}" Content="Reset" FontSize="10.5" Padding="6,3" Margin="1,0" ToolTip="Reset offset ke 0s"/>
                            </StackPanel>

                            <!-- Tengah: Media Controls (Previous, Play/Pause, Next) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding PreviousCommand}" Width="30" Height="30" Padding="0" ToolTip="Sebelumnya">
                                    <Path Data="M 0 0 H 2.5 V 12 H 0 Z M 11 0 L 3 6 L 11 12 Z" Fill="{DynamicResource ThemeTextBody}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                                <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding TogglePlayPauseCommand}" 
                                        Width="36" Height="36" Margin="6,0" Padding="0" ToolTip="Putar / Jeda">
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#FFFFFF">
                                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Play icon (triangle) -->
                                            <Path Data="M 0 0 L 11 7 L 0 14 Z" Fill="#000000" Margin="2,0,0,0"
                                                  Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible, TargetNullValue=Visible}"/>
                                            <!-- Pause icon (two bars) -->
                                            <Path Data="M 0 0 H 3.5 V 12 H 0 Z M 6 0 H 9.5 V 12 H 6 Z" Fill="#000000"
                                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                                        </Grid>
                                    </Border>
                                </Button>
                                <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding NextCommand}" Width="30" Height="30" Padding="0" ToolTip="Berikutnya">
                                    <Path Data="M 0 0 L 8 6 L 0 12 Z M 8.5 0 H 11 V 12 H 8.5 Z" Fill="{DynamicResource ThemeTextBody}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- Kanan: Import LRC / TXT -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ImportLyricsCommand}" Content="Impor File (.lrc/.txt)" FontSize="10.5" Padding="7,3" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <!-- ===== PEMISAH VERTIKAL 1: MUSIK | WAKTU SHOLAT ===== -->
                    <Border Grid.Column="1" Width="1" Background="{DynamicResource ThemeSurfaceRaised}" Margin="10,2"
                            Visibility="{Binding ShowExpandedPrayerDivider1, Converter={StaticResource BoolToVis}}"/>

                    <!-- ===== KOLOM 2: WAKTU SHOLAT (EXPANDED) ===== -->
                    <Grid Grid.Column="2" Visibility="{Binding ShowPrayerSectionInMainWindow, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Next Prayer Card -->
                            <RowDefinition Height="*"/>    <!-- Daily Schedule List -->
                            <RowDefinition Height="Auto"/> <!-- Status / Footer -->
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Waktu Sholat, Kota, Tanggal Hijriah, Lepas -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource MetallicIconBadgeBgBrush}"
                                            BorderBrush="{DynamicResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource LuxuryPrayerIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                              Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Waktu Sholat" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Background="{DynamicResource ThemeSurface}" CornerRadius="4" Padding="5,1" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentPrayerSchedule.CityName}" Foreground="{DynamicResource ThemeTextBody}" FontSize="9.5" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding CurrentPrayerSchedule.HijriDate}" FontSize="9.5" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding DetachPrayerCommand}"
                                        Content="{icons:Icon OpenInNew}" ToolTip="Lepas Waktu Sholat ke jendela terpisah" Margin="0,0,3,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="{icons:Icon Settings}" ToolTip="Pengaturan Waktu Sholat" Margin="0,0,3,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ClosePrayerCommand}" Content="{icons:Icon Close}" ToolTip="Tutup Waktu Sholat"/>
                            </StackPanel>
                        </Grid>

                        <!-- Highlight Next Prayer Card -->
                        <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1.2" 
                                CornerRadius="10" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="WAKTU BERIKUTNYA" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,1"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NextPrayerName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding NextPrayerTimeFormatted}" FontSize="15" FontWeight="Light" Foreground="{DynamicResource ThemeTextBody}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceRaised}" CornerRadius="6" Padding="6,3" VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="HITUNG MUNDUR" FontSize="7.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding NextPrayerCountdownBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Today's Schedule Cards List -->
                        <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="10" Padding="5,4" Height="172">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding CurrentPrayerSchedule.Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,4" Margin="0,1,0,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="11.5" FontWeight="Bold" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                        <Setter Property="FontSize" Value="12"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <Border Grid.Column="2" CornerRadius="4" Padding="5,1.5" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding CountdownText}" FontSize="9" FontWeight="Medium">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Footer: Pengingat Status -->
                        <Grid Grid.Row="3" Margin="2,4,2,0">
                            <TextBlock Text="Pengingat: -10m &#x2022; Adzan &#x2022; +15m" FontSize="9.5" Foreground="{DynamicResource ThemeTextMuted}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- ===== PEMISAH VERTIKAL 2: WAKTU SHOLAT | TO-DO ===== -->
                    <Border Grid.Column="3" Width="1" Background="{DynamicResource ThemeSurfaceRaised}" Margin="10,2"
                            Visibility="{Binding ShowExpandedPrayerDivider2, Converter={StaticResource BoolToVis}}"/>

                    <!-- ===== SISI KANAN: TO-DO LIST ===== -->
                    <Grid Grid.Column="4" Margin="0,0,2,0" Visibility="{Binding ShowTodoSectionInMainWindow, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Header -->
                            <RowDefinition Height="Auto"/> <!-- Filter Tabs -->
                            <RowDefinition Height="Auto"/> <!-- Input New Task -->
                            <RowDefinition Height="*"/>    <!-- Task List -->
                        </Grid.RowDefinitions>

                        <!-- Header: Judul, Ringkasan, dan Tombol Tutup -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Tombol Pin & Pengaturan saat mode Hanya To-Do (Music disembunyikan) -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePinCommand}" ToolTip="Pin agar tetap terbuka"
                                        Visibility="{Binding ShowMusicSection, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,4,0">
                                    <icons:IconPath Kind="Pin" Width="12" Height="12"/>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ToggleComponentsMenuCommand}" ToolTip="Kelola komponen notch"
                                        Visibility="{Binding ShowMusicSection, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,4,0">
                                    <TextBlock Text="&#x1F371;" FontSize="10"/>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="{icons:Icon Settings}" ToolTip="Pengaturan"
                                        Visibility="{Binding ShowMusicSection, Converter={StaticResource InverseBoolToVis}}" Margin="0,0,4,0"/>

                                <!-- Tombol Lepas Jendela To-Do ke jendela melayang tersendiri -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding DetachTodoCommand}"
                                        Content="{icons:Icon OpenInNew}" ToolTip="Lepas To-Do List ke jendela terpisah" Margin="0,0,4,0"/>

                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ClearCompletedTodosCommand}" 
                                        Visibility="{Binding HasCompletedTodos, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Hapus semua tugas yang selesai" Padding="6,2" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:IconPath Kind="Delete" Width="12" Height="12" Margin="0,0,3,0"/>
                                        <TextBlock Text="Bersihkan" FontSize="10.5"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ExpandAllCategoriesCommand}"
                                        ToolTip="Buka (Expand) seluruh kategori tugas" Padding="6,2" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⊞" FontSize="10" Margin="0,0,3,0"/>
                                        <TextBlock Text="Buka Semua" FontSize="10.5"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding CollapseAllCategoriesCommand}"
                                        ToolTip="Tutup (Collapse) seluruh kategori tugas" Padding="6,2" Margin="3,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⊟" FontSize="10" Margin="0,0,3,0"/>
                                        <TextBlock Text="Tutup Semua" FontSize="10.5"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Compact" Content="{icons:Icon ChevronUp}" ToolTip="Tutup ke Compact" Margin="0,0,3,0"/>
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding CloseTodoCommand}" Content="{icons:Icon Close}" ToolTip="Tutup To-Do List" Margin="0"/>

                                <!-- Pembatas Garis: To-Do List | Browser -->
                                <Border Width="1.2" Height="20" Background="{DynamicResource ThemeSurfaceHigh}" Margin="7,0" VerticalAlignment="Center"
                                        ToolTip="Batas modular komponen To-Do List &amp; Browser"/>

                                <!-- Komponen Browser Mengambang -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenFloatingBrowserCommand}"
                                        ToolTip="Buka Browser Mengambang (YouTube, Streaming Film, Web Bebas)" Padding="8,4" Margin="0,0,5,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="{DynamicResource LuxuryBrowserIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock Text="Browser" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Tombol Close Aplikasi di ujung sebelah kanan -->
                                <Button Style="{StaticResource CloseAppButtonStyle}" Command="{Binding ExitApplicationCommand}"
                                        Content="{icons:Icon Close}" ToolTip="Tutup Aplikasi TAMANOTCH" Padding="7,4" Margin="0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="24" Height="24" CornerRadius="7" Background="{DynamicResource MetallicIconBadgeBgBrush}"
                                        BorderBrush="{DynamicResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource LuxuryTodoIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="To-Do List" Foreground="{DynamicResource ThemeText}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TodoSummaryText}" Foreground="{DynamicResource ThemeTextBody}" FontSize="10.5" FontWeight="Medium"/>
                                </Border>

                                <!-- Tombol Status Google Drive (Klik untuk Login / Sync) -->
                                <Button Style="{StaticResource SmallPillButton}" Command="{Binding SyncGoogleDriveCommand}"
                                        ToolTip="{Binding GoogleDriveSyncTooltip}" Padding="6,2" Margin="6,0,0,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="&#x2601;" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#FFAA44"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                            <Setter Property="Foreground" Value="#4CD964"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding GoogleDriveStatusButtonText}" FontSize="10" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- Filter Tabs -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="All">
                                    <TextBlock Text="Semua">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAllFilterSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Active">
                                    <TextBlock Text="Aktif">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActiveFilterSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                                <Button Style="{StaticResource FilterPillStyle}" Command="{Binding SetTodoFilterCommand}" CommandParameter="Completed">
                                    <TextBlock Text="Selesai">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompletedFilterSelected}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </StackPanel>

                            <!-- Kategori Filter Chips (Tampil jika ada kategori) -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}" Margin="0,5,0,0">
                                <ItemsControl ItemsSource="{Binding AvailableCategories}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource FilterPillStyle}"
                                                    Command="{Binding DataContext.SetCategoryFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Margin="0,0,4,0" Padding="6,1.5">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="#" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9" Margin="0,0,2,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>

                        <!-- Input Tugas Baru (Dengan Pilihan Kategori & Target Waktu) -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <!-- Active Target Deadline Pill -->
                            <Border Visibility="{Binding HasNewTodoDueDate, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource ThemeSurface}" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="6"
                                    Padding="8,2" Margin="0,0,0,6" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                          Width="11" Height="11" Stretch="Uniform" Fill="#FFAA00" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Target: " Foreground="#FFAA00" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NewTodoDueDateText}" Foreground="#FFD080" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Command="{Binding ClearNewTodoDueDateCommand}" Background="Transparent" BorderThickness="0"
                                            Foreground="#FFAA00" Cursor="Hand" Padding="2,0" VerticalAlignment="Center" ToolTip="Batalkan target waktu">
                                        <icons:IconPath Kind="Close" Width="12" Height="12"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Dropdown / Input Kategori -->
                                    <ColumnDefinition Width="90"/>
                                    <!-- Input Teks Tugas -->
                                    <ColumnDefinition Width="*"/>
                                    <!-- Tombol Target Waktu (Vector Clock Icon - High Contrast) -->
                                    <ColumnDefinition Width="Auto"/>
                                    <!-- Tombol Tambah (+) -->
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Pilihan Kategori Dropdown / Input -->
                                <ComboBox Grid.Column="0" 
                                          IsEditable="True"
                                          ItemsSource="{Binding ExistingCategories}"
                                          Text="{Binding NewTodoCategory, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource DarkCategoryComboBoxStyle}"
                                          Margin="0,0,5,0" VerticalAlignment="Center"
                                          ToolTip="Pilih atau ketik kategori/tag tugas (misal: MARIBON)"/>

                                <!-- Input Teks Tugas -->
                                <Grid Grid.Column="1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBox x:Name="NewTodoTextBox" 
                                             Text="{Binding NewTodoTitle, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource TodoTextBoxStyle}" VerticalAlignment="Center">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddTodoCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <!-- Placeholder / Watermark -->
                                    <TextBlock Text="Tulis tugas lalu Enter..." Foreground="{DynamicResource ThemeTextMuted}" FontSize="11"
                                               IsHitTestVisible="False" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NewTodoTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <!-- Tombol Target Waktu (Vector Clock Icon - High Contrast) -->
                                <Border Grid.Column="2" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Button x:Name="MainWindowDeadlineButton"
                                            Command="{Binding ToggleSetDeadlineCommand}"
                                            ToolTip="Atur target tanggal dan jam selesai"
                                            Width="28" Height="28" Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasNewTodoDueDate}" Value="True">
                                                        <Setter Property="Background" Value="#382410"/>
                                                        <Setter Property="BorderBrush" Value="#FFAA00"/>
                                                        <Setter Property="Foreground" Value="#FFAA00"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                        <Setter Property="BorderBrush" Value="#686888"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1.5" CornerRadius="8">
                                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                                          Width="14" Height="14" Stretch="Uniform" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Border>

                                <!-- Popup Pilihan Deadline -->
                                <Popup IsOpen="{Binding IsSettingNewTodoDeadline, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=MainWindowDeadlineButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1.5" CornerRadius="10"
                                            Padding="10" Margin="0,4,0,0" Width="280">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                                <Button DockPanel.Dock="Right" Command="{Binding ToggleSetDeadlineCommand}"
                                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextSecondary}" Cursor="Hand" Padding="4,0" ToolTip="Tutup">
                                                    <icons:IconPath Kind="Close" Width="12" Height="12"/>
                                                </Button>
                                                <TextBlock Text="Target Waktu Selesai" Foreground="{DynamicResource ThemeText}" FontWeight="Bold" FontSize="11.5"/>
                                            </DockPanel>

                                            <!-- Quick Presets -->
                                            <TextBlock Text="Pilihan Cepat:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="plus_1h"
                                                        Content="+1 Jam" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="plus_3h"
                                                        Content="+3 Jam" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="today_17"
                                                        Content="Hari ini 17:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="today_21"
                                                        Content="Malam 21:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="tomorrow_09"
                                                        Content="Besok 09:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                <Button Command="{Binding SetDeadlinePresetCommand}" CommandParameter="tomorrow_17"
                                                        Content="Besok 17:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                            </WrapPanel>

                                            <!-- Divider -->
                                            <Border Height="1" Background="{DynamicResource ThemeSurfaceRaised}" Margin="0,0,0,8"/>

                                            <!-- Kustom Tanggal & Jam -->
                                            <TextBlock Text="Kustom Tanggal &amp; Jam:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <DatePicker SelectedDate="{Binding CustomDeadlineDate, Mode=TwoWay}"
                                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox Grid.Column="1" Text="{Binding CustomDeadlineHour, Mode=TwoWay}" Width="32" Height="26"
                                                         Style="{StaticResource TodoTextBoxStyle}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                         ToolTip="Jam (0-23)"/>
                                                <TextBlock Grid.Column="1" Text=":" Foreground="{DynamicResource ThemeText}" FontWeight="Bold" VerticalAlignment="Center" Margin="34,0,0,0" HorizontalAlignment="Right"/>
                                                <TextBox Grid.Column="2" Text="{Binding CustomDeadlineMinute, Mode=TwoWay}" Width="32" Height="26"
                                                         Style="{StaticResource TodoTextBoxStyle}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                         ToolTip="Menit (0-59)" Margin="4,0,0,0"/>
                                            </Grid>

                                            <DockPanel LastChildFill="False">
                                                <Button DockPanel.Dock="Left" Command="{Binding ClearNewTodoDueDateCommand}"
                                                        Visibility="{Binding HasNewTodoDueDate, Converter={StaticResource BoolToVis}}"
                                                        Content="Hapus Target" Background="Transparent" Foreground="#FF6B8B" BorderThickness="0"
                                                        FontSize="11" Cursor="Hand" Padding="0,4"/>
                                                <Button DockPanel.Dock="Right" Command="{Binding ApplyCustomDeadlineCommand}"
                                                        Content="Terapkan" Background="#4D96FF" Foreground="{DynamicResource ThemeText}" BorderThickness="0"
                                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand" Padding="12,5">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Tombol Tambah (+) -->
                                <Button Grid.Column="3" Command="{Binding AddTodoCommand}" ToolTip="Tambah Tugas"
                                        Background="#FFFFFF" Foreground="#000000" Width="28" Height="28" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <TextBlock Text="+" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                                           FontWeight="Bold" FontSize="15" Foreground="#000000"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Daftar Tugas (Scrollable) -->
                        <Border Grid.Row="3" Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="10" Padding="6,4" Height="172">
                            <Grid>
                                <!-- Tampilan saat kosong -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding FilteredTodos.IsEmpty, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="&#x1F389;" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Tidak ada tugas saat ini" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <!-- List Item -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                    <ItemsControl ItemsSource="{Binding FilteredTodos}">
                                        <ItemsControl.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.ContainerStyle>
                                                    <Style TargetType="{x:Type GroupItem}">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                                    <Expander helpers:TodoCategoryExpansionHelper.CategoryName="{Binding Name}"
                                                                              Style="{StaticResource CleanCategoryExpanderStyle}">
                                                                        <Expander.Header>
                                                                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                                                        </Expander.Header>
                                                                        <!-- Batang Pohon / Garis Cabang Vertikal -->
                                                                        <Border Margin="10,2,0,0" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1.5,0,0,0" Padding="8,0,0,0">
                                                                            <ItemsPresenter/>
                                                                        </Border>
                                                                    </Expander>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GroupStyle.ContainerStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,4,0,3" Padding="2,1"
                                                                Background="Transparent"
                                                                helpers:TodoCategoryDragDropBehavior.IsEnabled="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <!-- Drag Handle Grip -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Tombol Chevron Expand/Collapse (▾ / ▸) -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Ikon Folder Kategori -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Nama Kategori -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Badge Jumlah Tugas -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <!-- Garis Cabang Horizontal -->
                                                                    <ColumnDefinition Width="*"/>
                                                                    <!-- Tombol Pindah Kategori Naik / Turun -->
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Drag Handle Grip untuk Kategori -->
                                                                <Border Grid.Column="0" Background="Transparent" Width="14" Height="18" Margin="0,0,2,0"
                                                                        Cursor="SizeAll" ToolTip="Tahan dan geser (drag &amp; drop) untuk memindahkan urutan kategori beserta seluruh tugasnya">
                                                                    <TextBlock Text="⋮⋮" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" FontWeight="Bold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Tombol Expand / Collapse Chevron (▾ / ▸) -->
                                                                <ToggleButton Grid.Column="1"
                                                                              Style="{StaticResource CategoryChevronToggleStyle}"
                                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}, Mode=TwoWay}"
                                                                              ToolTip="Buka / Tutup Kategori"/>

                                                                <!-- Ikon Folder Kategori -->
                                                                <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1" CornerRadius="4"
                                                                        Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                    <icons:IconPath Kind="Folder" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>

                                                                <!-- Nama Kategori -->
                                                                <TextBlock Grid.Column="3" Text="{Binding Name}" Foreground="{DynamicResource ThemeTextBody}" FontSize="11" FontWeight="Bold"
                                                                           VerticalAlignment="Center" Cursor="Hand" ToolTip="Klik untuk buka / tutup kategori">
                                                                    <TextBlock.InputBindings>
                                                                        <MouseBinding MouseAction="LeftClick"
                                                                                      Command="{Binding DataContext.ToggleCategoryCollapseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                                      CommandParameter="{Binding Name}"/>
                                                                    </TextBlock.InputBindings>
                                                                </TextBlock>

                                                                <!-- Badge Jumlah Tugas -->
                                                                <Border Grid.Column="4" Background="{DynamicResource ThemeSurface}" CornerRadius="8" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding ItemCount, StringFormat='{}{0}'}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9" FontWeight="SemiBold"/>
                                                                </Border>

                                                                <!-- Garis Cabang Horizontal -->
                                                                <Border Grid.Column="5" Height="1" Background="{DynamicResource ThemeSurfaceRaised}" Margin="8,0,8,0" VerticalAlignment="Center"/>

                                                                <!-- Tombol Pindah Kategori Naik / Turun -->
                                                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Style="{StaticResource CategoryOrderButtonStyle}"
                                                                            Command="{Binding DataContext.MoveCategoryUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Content="{icons:Icon ChevronUp}" ToolTip="Geser kategori ke atas (anak tugas ikut)"/>
                                                                    <Button Style="{StaticResource CategoryOrderButtonStyle}"
                                                                            Command="{Binding DataContext.MoveCategoryDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                            CommandParameter="{Binding Name}"
                                                                            Content="{icons:Icon ChevronDown}" ToolTip="Geser kategori ke bawah (anak tugas ikut)" Margin="3,0,0,0"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ItemsControl.GroupStyle>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="8" Padding="6,5" Margin="0,2,0,2"
                                                        helpers:TodoDragDropBehavior.IsEnabled="True">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <!-- Garis Penghubung Cabang ├──• -->
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Drag Handle Grip -->
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Checkbox -->
                                                            <ColumnDefinition Width="Auto"/>
                                                            <!-- Judul Tugas & Target Waktu -->
                                                            <ColumnDefinition Width="*"/>
                                                            <!-- Tombol Aksi (Edit & Hapus) -->
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Penghubung Cabang Horisontal (Branch Arm) -->
                                                        <Grid Grid.Column="0" Width="10" Height="18" VerticalAlignment="Center" Margin="-6,0,3,0">
                                                            <Rectangle Height="1.5" Width="6" Fill="#36364A" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                            <Ellipse Width="3.5" Height="3.5" Fill="#5A5A72" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>

                                                        <!-- Drag Grip Handle ⋮⋮ -->
                                                        <Border Grid.Column="1" Width="14" Height="20" Background="Transparent" Cursor="SizeAll"
                                                                VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="Tahan dan geser naik/turun untuk ubah urutan">
                                                            <TextBlock Text="⋮⋮" Foreground="{DynamicResource ThemeTextMuted}" FontSize="11" FontWeight="Bold"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <!-- Checkbox -->
                                                        <CheckBox Grid.Column="2" IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                                  Style="{StaticResource TodoCheckBoxStyle}"
                                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                        <!-- Judul Tugas & Target Waktu (Mode Tampilan) -->
                                                        <DockPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"
                                                                   ToolTip="Klik dua kali atau klik ikon pensil untuk mengedit tugas"
                                                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                            <DockPanel.InputBindings>
                                                                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding StartEditCommand}"/>
                                                            </DockPanel.InputBindings>

                                                            <!-- Target Waktu Badge dengan Remaining Time & Day -->
                                                            <Border DockPanel.Dock="Right" Visibility="{Binding HasDueDate, Converter={StaticResource BoolToVis}}"
                                                                    Background="{Binding DueBadgeBackground}" BorderBrush="{Binding DueBadgeBorder}" BorderThickness="1"
                                                                    CornerRadius="4" Padding="5,1" Margin="6,0,2,0" VerticalAlignment="Center"
                                                                    ToolTip="{Binding DueDateFullTooltip}">
                                                                <Border.ContextMenu>
                                                                    <ContextMenu Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeLineStrong}">
                                                                        <MenuItem Header="Hapus Target Waktu" Command="{Binding ClearDueDateCommand}"/>
                                                                        <Separator Background="{DynamicResource ThemeSurfaceHigh}"/>
                                                                        <MenuItem Header="+1 Jam" Command="{Binding SetDueDatePresetCommand}" CommandParameter="plus_1h"/>
                                                                        <MenuItem Header="+3 Jam" Command="{Binding SetDueDatePresetCommand}" CommandParameter="plus_3h"/>
                                                                        <MenuItem Header="Hari ini 17:00" Command="{Binding SetDueDatePresetCommand}" CommandParameter="today_17"/>
                                                                        <MenuItem Header="Malam ini 21:00" Command="{Binding SetDueDatePresetCommand}" CommandParameter="today_21"/>
                                                                        <MenuItem Header="Besok 09:00" Command="{Binding SetDueDatePresetCommand}" CommandParameter="tomorrow_09"/>
                                                                        <MenuItem Header="Besok 17:00" Command="{Binding SetDueDatePresetCommand}" CommandParameter="tomorrow_17"/>
                                                                    </ContextMenu>
                                                                </Border.ContextMenu>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                                                          Width="9.5" Height="9.5" Stretch="Uniform" Fill="{Binding DueBadgeForeground}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding DueDateBadgeText}" Foreground="{Binding DueBadgeForeground}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Teks Tugas -->
                                                            <TextBlock Text="{Binding TaskText}" VerticalAlignment="Center"
                                                                       FontSize="11.5" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DockPanel>

                                                        <!-- Mode Edit Inline (Input Teks + Pilihan Target Waktu) -->
                                                        <Grid Grid.Column="3" Margin="0,0,6,0" VerticalAlignment="Center"
                                                              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0" Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource TodoTextBoxStyle}"
                                                                     FontSize="11.5" Padding="6,3" VerticalAlignment="Center"
                                                                     ToolTip="Tekan Enter untuk simpan, Esc untuk batal">
                                                                <TextBox.InputBindings>
                                                                    <KeyBinding Key="Enter" Command="{Binding SaveEditCommand}"/>
                                                                    <KeyBinding Key="Esc" Command="{Binding CancelEditCommand}"/>
                                                                </TextBox.InputBindings>
                                                            </TextBox>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                                                <!-- Target Pill if active in edit mode -->
                                                                <Border Visibility="{Binding HasEditDueDate, Converter={StaticResource BoolToVis}}"
                                                                        Background="{DynamicResource ThemeSurface}" BorderBrush="#FFAA00" BorderThickness="1" CornerRadius="4"
                                                                        Padding="5,1" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Target waktu tugas (Klik tombol jam untuk ubah)">
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                        <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                                                              Width="9" Height="9" Stretch="Uniform" Fill="#FFAA00" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding EditDueDateText}" Foreground="#FFD080" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                        <Button Command="{Binding ClearEditDueDateCommand}" Background="Transparent" BorderThickness="0"
                                                                                Foreground="#FFAA00" Cursor="Hand" Padding="2,0" Margin="3,0,0,0" ToolTip="Hapus target waktu">
                                                                            <icons:IconPath Kind="Close" Width="12" Height="12"/>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Tombol Target Waktu Edit -->
                                                                <Border VerticalAlignment="Center">
                                                                    <Button x:Name="MainWindowEditDeadlineButton"
                                                                            Command="{Binding ToggleEditDueDateMainCommand}"
                                                                            ToolTip="Atur target tanggal dan jam selesai"
                                                                            Width="24" Height="24" Cursor="Hand">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
                                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding HasEditDueDate}" Value="True">
                                                                                        <Setter Property="Background" Value="#382410"/>
                                                                                        <Setter Property="BorderBrush" Value="#FFAA00"/>
                                                                                        <Setter Property="Foreground" Value="#FFAA00"/>
                                                                                    </DataTrigger>
                                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                                        <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                                        <Setter Property="BorderBrush" Value="#686888"/>
                                                                                    </Trigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <Button.Template>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                                        BorderThickness="1.2" CornerRadius="6">
                                                                                    <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                                                                          Width="12" Height="12" Stretch="Uniform" Fill="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Button.Template>
                                                                    </Button>
                                                                </Border>

                                                                <!-- Popup Pilihan Deadline Edit -->
                                                                <Popup IsOpen="{Binding IsSettingEditDueDateInMain, Mode=TwoWay}"
                                                                       PlacementTarget="{Binding ElementName=MainWindowEditDeadlineButton}"
                                                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                                                    <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1.5" CornerRadius="10"
                                                                            Padding="10" Margin="0,4,0,0" Width="280">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                                                        </Border.Effect>
                                                                        <StackPanel>
                                                                            <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                                                                <Button DockPanel.Dock="Right" Command="{Binding CloseEditDueDatePopupCommand}"
                                                                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource ThemeTextSecondary}" Cursor="Hand" Padding="4,0" ToolTip="Tutup">
                                                                                    <icons:IconPath Kind="Close" Width="12" Height="12"/>
                                                                                </Button>
                                                                                <TextBlock Text="Target Waktu Selesai" Foreground="{DynamicResource ThemeText}" FontWeight="Bold" FontSize="11.5"/>
                                                                            </DockPanel>

                                                                            <!-- Quick Presets -->
                                                                            <TextBlock Text="Pilihan Cepat:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                                                                            <WrapPanel Margin="0,0,0,8">
                                                                                <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="plus_1h"
                                                                                        Content="+1 Jam" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                                <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="plus_3h"
                                                                                Content="+3 Jam" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                                <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="today_17"
                                                                                        Content="Hari ini 17:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                                <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="today_21"
                                                                                        Content="Malam 21:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                                <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="tomorrow_09"
                                                                                        Content="Besok 09:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                                <Button Command="{Binding SetEditDueDatePresetCommand}" CommandParameter="tomorrow_17"
                                                                                        Content="Besok 17:00" Style="{StaticResource QuickPresetButtonStyle}"/>
                                                                            </WrapPanel>

                                                                            <!-- Divider -->
                                                                            <Border Height="1" Background="{DynamicResource ThemeSurfaceRaised}" Margin="0,0,0,8"/>

                                                                            <!-- Kustom Tanggal & Jam -->
                                                                            <TextBlock Text="Kustom Tanggal &amp; Jam:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" Margin="0,0,0,4"/>
                                                                            <Grid Margin="0,0,0,8">
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <DatePicker SelectedDate="{Binding EditCustomDeadlineDate, Mode=TwoWay}"
                                                                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                                                <TextBox Grid.Column="1" Text="{Binding EditCustomDeadlineHour, Mode=TwoWay}" Width="32" Height="26"
                                                                                         Style="{StaticResource TodoTextBoxStyle}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                                                         ToolTip="Jam (0-23)"/>
                                                                                <TextBlock Grid.Column="1" Text=":" Foreground="{DynamicResource ThemeText}" FontWeight="Bold" VerticalAlignment="Center" Margin="34,0,0,0" HorizontalAlignment="Right"/>
                                                                                <TextBox Grid.Column="2" Text="{Binding EditCustomDeadlineMinute, Mode=TwoWay}" Width="32" Height="26"
                                                                                         Style="{StaticResource TodoTextBoxStyle}" HorizontalContentAlignment="Center" VerticalAlignment="Center"
                                                                                         ToolTip="Menit (0-59)" Margin="4,0,0,0"/>
                                                                            </Grid>

                                                                            <DockPanel LastChildFill="False">
                                                                                <Button DockPanel.Dock="Left" Command="{Binding ClearEditDueDateCommand}"
                                                                                        Visibility="{Binding HasEditDueDate, Converter={StaticResource BoolToVis}}"
                                                                                        Content="Hapus Target" Background="Transparent" Foreground="#FF6B8B" BorderThickness="0"
                                                                                        FontSize="11" Cursor="Hand" Padding="0,4"/>
                                                                                <Button DockPanel.Dock="Right" Command="{Binding ApplyEditCustomDeadlineCommand}"
                                                                                        Content="Terapkan" Background="#4D96FF" Foreground="{DynamicResource ThemeText}" BorderThickness="0"
                                                                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand" Padding="12,5">
                                                                                    <Button.Template>
                                                                                        <ControlTemplate TargetType="Button">
                                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                            </Border>
                                                                                        </ControlTemplate>
                                                                                    </Button.Template>
                                                                                </Button>
                                                                            </DockPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Popup>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Tombol Aksi saat Normal (Edit &#x270E; &amp; Hapus &#x2715;) -->
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                            <Button Command="{Binding StartEditCommand}"
                                                                    Style="{StaticResource TodoDeleteButtonStyle}"
                                                                    ToolTip="Edit tugas" Width="20" Height="20" Margin="0,0,2,0">
                                                                <icons:IconPath Kind="Edit" Width="12" Height="12" Fill="{DynamicResource ThemeTextMuted}" Margin="0,-1,0,0"/>
                                                            </Button>
                                                            <Button Command="{Binding DeleteCommand}"
                                                                    Style="{StaticResource TodoDeleteButtonStyle}"
                                                                    ToolTip="Hapus tugas" Width="20" Height="20">
                                                                <icons:IconPath Kind="Close" Width="12" Height="12" Margin="0,-2,0,0"/>
                                                            </Button>
                                                        </StackPanel>

                                                        <!-- Tombol Aksi saat Mode Edit (Simpan &#x2713; &amp; Batal &#x2715;) -->
                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                            <Button Command="{Binding SaveEditCommand}"
                                                                    Style="{StaticResource TodoDeleteButtonStyle}"
                                                                    ToolTip="Simpan (Enter)" Width="20" Height="20" Margin="0,0,2,0">
                                                                <icons:IconPath Kind="Check" Width="12" Height="12" Fill="#4CD964"/>
                                                            </Button>
                                                            <Button Command="{Binding CancelEditCommand}"
                                                                    Style="{StaticResource TodoDeleteButtonStyle}"
                                                                    ToolTip="Batal (Esc)" Width="20" Height="20">
                                                                <icons:IconPath Kind="Close" Width="12" Height="12" Fill="#FF4D6D"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== TAMPILAN KHUSUS WAKTU SHOLAT ===== -->
                <Grid Visibility="{Binding ShowPrayerExpandedContent, Converter={StaticResource BoolToVis}}" Width="412" Margin="4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Highlight Next Prayer Card -->
                        <RowDefinition Height="*"/>    <!-- Today's Schedule Cards -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Actions & Status -->
                    </Grid.RowDefinitions>

                    <!-- Header: Title, City, Hijri Date, Back Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource MetallicIconBadgeBgBrush}"
                                        BorderBrush="{DynamicResource MetallicIconBadgeBorderBrush}" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Path Data="{DynamicResource LuxuryPrayerIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                          Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Waktu Sholat" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource ThemeSurface}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPrayerSchedule.CityName}" Foreground="{DynamicResource ThemeTextBody}" FontSize="10.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentPrayerSchedule.HijriDate}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding DetachPrayerCommand}" Content="{icons:Icon OpenInNew}" ToolTip="Lepas Waktu Sholat ke Jendela Sendiri" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" Content="{icons:Icon Settings}" ToolTip="Pengaturan Waktu Sholat" Margin="0,0,4,0"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding TogglePrayerPanelCommand}" Content="{icons:Icon Close}" ToolTip="Kembali ke Pemutar"/>
                        </StackPanel>
                    </Grid>

                    <!-- Next Prayer Countdown Banner Card -->
                    <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1.2" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="WAKTU BERIKUTNYA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding NextPrayerName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding NextPrayerTimeFormatted}" FontSize="18" FontWeight="Light" Foreground="{DynamicResource ThemeTextBody}"/>
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceRaised}" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="HITUNG MUNDUR" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding NextPrayerCountdownBadge}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Schedule Cards Grid (Imsak, Subuh, Terbit, Dzuhur, Ashar, Maghrib, Isya) -->
                    <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="10" Padding="8,6" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding CurrentPrayerSchedule.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="10,6" Margin="0,2,0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="13" FontWeight="Bold" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                <Setter Property="FontSize" Value="13.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <Border Grid.Column="2" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding CountdownText}" FontSize="10" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- Bottom Status & Actions -->
                    <DockPanel Grid.Row="3" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Style="{StaticResource SmallPillButton}" Command="{Binding TogglePrayerPanelCommand}" 
                                Content="&#x2190; Kembali" Padding="10,4" Margin="6,0,0,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pengingat aktif: Sebelum (-10m) &#x2022; Saat Adzan &#x2022; Sesudah (+15m)" FontSize="10" Foreground="{DynamicResource ThemeTextMuted}"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>

                <!-- ================= MODE 3: LYRICS (LUXURY MAC KARAOKE STAGE) ================= -->
                <Grid x:Name="LyricsView" Visibility="{Binding IsLyricsMode, Converter={StaticResource BoolToVis}}" 
                      Width="640" Height="400" Margin="24,18,24,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar (Album Art + Crisp Track Info + Mode Pills without Click-Through) -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Luxury Squircle Album Art -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" ClipToBounds="True"
                                Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="#36FFFFFF" BorderThickness="1.2" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Grid>
                                <Path Data="{DynamicResource LuxuryMusicNoteGeometry}" Fill="{DynamicResource MetallicSilverBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding CurrentTrack.Thumbnail}" Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding CurrentTrack.Title, FallbackValue='TAMANOTCH'}"
                                       FontWeight="Bold" FontSize="17" Foreground="{DynamicResource ThemeText}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentTrack.Artist, FallbackValue='Siap memutar musik...'}"
                                       FontSize="13" FontWeight="Medium" Foreground="{DynamicResource ThemeTextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Expanded"
                                    Content="Expanded" FontSize="12.5" Padding="14,6" Margin="0,0,6,0" ToolTip="Buka Panel Penuh"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding SetModeCommand}" CommandParameter="Compact"
                                    Content="Compact" FontSize="12.5" Padding="14,6" Margin="0,0,6,0" ToolTip="Kembali ke Notch"/>
                            <Button Style="{StaticResource CloseAppButtonStyle}" Command="{Binding ExitApplicationCommand}"
                                    Content="{icons:Icon Close}" FontSize="12.5" Padding="10,6" Margin="0" ToolTip="Tutup Aplikasi TAMANOTCH"/>
                        </StackPanel>
                    </Grid>

                    <!-- Big Central Focused Lyrics Stage (Obsidian Velvet Glass) -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1.2" CornerRadius="18" Padding="24,18">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#0D0D14" Offset="0.0"/>
                                <GradientStop Color="#07070B" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid VerticalAlignment="Center">
                            <!-- Standby / Empty State when no track is playing -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding HasTrack, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="&#x266A;" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Belum Ada Lagu yang Diputar" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextBody}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Putar musik dari YouTube Music, Spotify, atau browser untuk menampilkan lirik karaoke otomatis."
                                           FontSize="12.5" Foreground="{DynamicResource ThemeTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,6,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenYouTubeMusicCommand}"
                                            ToolTip="Buka Pemutar YouTube Music" Width="38" Height="38" Padding="0" Margin="0,0,8,0">
                                        <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Fill="#FF0033" Width="20" Height="20"/>
                                            <Path Data="M 0,0 L 7.5,5 L 0,10 Z" Fill="{DynamicResource ThemeText}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1.5,0,0,0"/>
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenSpotifyCommand}"
                                            ToolTip="Buka Pemutar Spotify" Width="38" Height="38" Padding="0">
                                        <Path Data="{StaticResource SpotifyIconGeometry}" Fill="#1DB954" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
<Button Style="{StaticResource SmallPillButton}" Command="{Binding OpenJellyfinCommand}"
                                            ToolTip="Buka Pemutar Jellyfin (myFlix)" Width="38" Height="38" Padding="0">
                                        <Path Data="{StaticResource JellyfinIconGeometry}" Fill="{StaticResource JellyfinBrush}" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Active Track Lyrics Container -->
                            <Grid Visibility="{Binding HasTrack, Converter={StaticResource BoolToVis}}">
                                <!-- Synced 3-Line Display -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding IsLyricsSynced, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding PreviousLyric}" FontSize="15.5" FontWeight="Medium" Foreground="{DynamicResource ThemeTextMuted}"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>
                                    <TextBlock Text="{Binding ActiveLyric}" FontSize="{Binding Settings.LyricsFontSize}" Foreground="{DynamicResource ThemeText}"
                                               FontWeight="ExtraBold" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#FFFFFF" BlurRadius="14" ShadowDepth="0" Opacity="0.22"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock Text="{Binding NextLyric}" FontSize="15.5" FontWeight="Medium" Foreground="{DynamicResource ThemeTextMuted}"
                                               TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,14,0,0"/>
                                </StackPanel>

                                <!-- Unsynced / Plain Lyrics Display -->
                                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding IsLyricsSynced, Converter={StaticResource InverseBoolToVis}}">
                                    <TextBlock Text="{Binding ActiveLyric}" FontSize="15.5" FontWeight="Medium" Foreground="{DynamicResource ThemeTextBody}"
                                               TextAlignment="Center" TextWrapping="Wrap" LineHeight="26"/>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Bottom Bar (Luxury Vector Transport Controls, Time, & Offset) -->
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding PreviousCommand}" Width="38" Height="34" Padding="0" ToolTip="Sebelumnya" Margin="0,0,6,0">
                                <Path Data="M 0 0 H 2.2 V 11 H 0 Z M 10 0 L 2.8 5.5 L 10 11 Z" Fill="{DynamicResource ThemeTextBody}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource ControlButtonStyle}" Command="{Binding TogglePlayPauseCommand}" Width="40" Height="38" Padding="0" ToolTip="Putar / Jeda" Margin="0,0,6,0">
                                <Border Width="36" Height="36" CornerRadius="18" Background="#FFFFFF">
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 0 0 L 11 6.5 L 0 13 Z" Fill="#000000" Margin="2,0,0,0"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVis}, FallbackValue=Visible, TargetNullValue=Visible}"/>
                                        <Path Data="M 0 0 H 3.5 V 12 H 0 Z M 6.2 0 H 9.7 V 12 H 6.2 Z" Fill="#000000"
                                              Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed, TargetNullValue=Collapsed}"/>
                                    </Grid>
                                </Border>
                            </Button>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding NextCommand}" Width="38" Height="34" Padding="0" ToolTip="Berikutnya" Margin="0">
                                <Path Data="M 0 0 L 7.2 5.5 L 0 11 Z M 7.8 0 H 10 V 11 H 7.8 Z" Fill="{DynamicResource ThemeTextBody}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="13" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetSubtractCommand}" Content="-0.5s" FontSize="12" Padding="11,6"/>
                            <TextBlock Text="{Binding ManualOffsetSeconds, StringFormat='{}{0:0.0}s'}" Foreground="{DynamicResource ThemeText}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0"/>
                            <Button Style="{StaticResource SmallPillButton}" Command="{Binding OffsetAddCommand}" Content="+0.5s" FontSize="12" Padding="11,6"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= FLOATING ISLAND TODO DEADLINE NOTIFICATION BANNER ================= -->
                <Border Grid.Row="0" Visibility="{Binding HasActiveTodoNotification, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="#FF4D6D" BorderThickness="1.5" CornerRadius="22"
                        Padding="12,6" Margin="4,2" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ThemeSurface}" Margin="0,0,10,0">
                            <Path Data="M 12,2 C 6.48,2 2,6.48 2,12 C 2,17.52 6.48,22 12,22 C 17.52,22 22,17.52 22,12 C 22,6.48 17.52,2 12,2 Z M 12,20 C 7.59,20 4,16.41 4,12 C 4,7.59 7.59,4 12,4 C 16.41,4 20,7.59 20,12 C 20,16.41 16.41,20 12,20 Z M 11.25,6.5 L 11.25,12.5 L 15.5,15 L 16.25,13.75 L 12.75,11.75 L 12.75,6.5 Z"
                                  Width="16" Height="16" Stretch="Uniform" Fill="#FF6B8B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock Text="{Binding ActiveTodoNotification.Title}" Foreground="#FF6B8B" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ActiveTodoNotification.Message}" Foreground="{DynamicResource ThemeTextBody}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Selesai Button -->
                        <Button Grid.Column="2" Command="{Binding CompleteTodoNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="Selesai" ToolTip="Tandai tugas selesai"
                                Background="{DynamicResource ThemeSurfaceRaised}" Foreground="#4CD964" BorderBrush="#2A5C32"
                                Height="24" Padding="8,0" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Dismiss button -->
                        <Button Grid.Column="3" Command="{Binding DismissTodoNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="{icons:Icon Close}" ToolTip="Tutup Notifikasi"
                                Width="24" Height="24" Padding="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ================= FLOATING ISLAND WELLNESS (GERAK / MINUM) REMINDER BANNER ================= -->
                <Border Grid.Row="0" Visibility="{Binding ShowWellnessBanner, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{Binding WellnessAccentColor}" BorderThickness="1.5" CornerRadius="22"
                        Padding="12,6" Margin="4,2" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon: jalan (gerak) atau tetes air (minum) -->
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ThemeSurface}" Margin="0,0,10,0">
                            <Grid>
                                <Path Width="17" Height="17" Stretch="Uniform" Fill="#FF7EB6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M13.5,5.5 C14.6,5.5 15.5,4.6 15.5,3.5 C15.5,2.4 14.6,1.5 13.5,1.5 C12.4,1.5 11.5,2.4 11.5,3.5 C11.5,4.6 12.4,5.5 13.5,5.5 Z M9.8,8.9 L7,23 L9.1,23 L10.9,15 L13,17 L13,23 L15,23 L15,15.5 L12.9,13.5 L13.5,10.5 C14.8,12 16.8,13 19,13 L19,11 C17.1,11 15.5,10 14.7,8.6 L13.7,7 C13.3,6.4 12.7,6 12,6 C11.7,6 11.5,6.1 11.2,6.1 L6,8.3 L6,13 L8,13 L8,9.6 L9.8,8.9 Z">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveWellnessNotification.Kind}" Value="Drink">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Width="15" Height="15" Stretch="Uniform" Fill="#4FC3F7" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M12,2 C12,2 5,10 5,15 C5,18.9 8.1,22 12,22 C15.9,22 19,18.9 19,15 C19,10 12,2 12,2 Z">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActiveWellnessNotification.Kind}" Value="Drink">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="300">
                            <TextBlock Text="{Binding ActiveWellnessNotification.Title}" Foreground="{Binding WellnessAccentColor}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ActiveWellnessNotification.Message}" Foreground="{DynamicResource ThemeTextBody}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Aksi utama (Sudah bergerak / Sudah minum) -->
                        <Button Grid.Column="2" Command="{Binding WellnessPrimaryActionCommand}"
                                Style="{StaticResource SmallPillButton}" Content="{Binding ActiveWellnessNotification.PrimaryActionText}"
                                Background="{DynamicResource ThemeSurfaceRaised}" Foreground="#4CD964" BorderBrush="#2A5C32"
                                Height="24" Padding="8,0" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Tunda 10 menit -->
                        <Button Grid.Column="3" Command="{Binding WellnessSnoozeCommand}"
                                Style="{StaticResource SmallPillButton}" Content="Tunda 10 mnt" ToolTip="Ingatkan lagi 10 menit lagi"
                                Height="24" Padding="8,0" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Tutup -->
                        <Button Grid.Column="4" Command="{Binding DismissWellnessNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="{icons:Icon Close}" ToolTip="Tutup"
                                Width="24" Height="24" Padding="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ================= FLOATING ISLAND BMKG EARTHQUAKE & WEATHER ALERT BANNER ================= -->
                <Border Grid.Row="0" Visibility="{Binding ShowBmkgBanner, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="#FF6B8B" BorderThickness="1.5" CornerRadius="22"
                        Padding="12,6" Margin="4,2" VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="#5A2838" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="{DynamicResource LuxuryBmkgIconGeometry}" Fill="#FF6B8B"
                                  Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right" Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="#FF6B8B" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveBmkgNotification.MagnitudeBadge}" Foreground="#FFB74D" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="{Binding ActiveBmkgNotification.Title}" Foreground="{DynamicResource ThemeText}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock Text="{Binding ActiveBmkgNotification.Message}" Foreground="{DynamicResource ThemeTextBody}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Lihat Detail Button -->
                        <Button Grid.Column="2" Command="{Binding OpenBmkgNotificationDetailCommand}"
                                Style="{StaticResource SmallPillButton}" Content="Lihat Detail" ToolTip="Buka detail gempa &amp; peta guncangan (Shakemap) BMKG"
                                Background="{DynamicResource ThemeSurfaceRaised}" Foreground="#FFB74D" BorderBrush="#5C3448"
                                Height="24" Padding="8,0" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <!-- Dismiss button -->
                        <Button Grid.Column="3" Command="{Binding DismissBmkgNotificationCommand}"
                                Style="{StaticResource SmallPillButton}" Content="{icons:Icon Close}" ToolTip="Tutup Peringatan BMKG"
                                Width="24" Height="24" Padding="0" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>    </Grid>
</Window>
