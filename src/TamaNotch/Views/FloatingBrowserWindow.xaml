<Window x:Class="TamaNotch.Views.FloatingBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:TamaNotch.Helpers"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Browser Mengambang - TAMANOTCH"
        Width="960" Height="540" MinWidth="320" MinHeight="180"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="{DynamicResource ThemeSurfaceDeep}" Foreground="{DynamicResource ThemeTextBody}">

    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="WindowChromeElement" CaptionHeight="34" CornerRadius="8" GlassFrameThickness="0" ResizeBorderThickness="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetChipStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2D2248"/>
                                <Setter Property="BorderBrush" Value="#8A2BE2"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCaptionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseWindowButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer border: 5px padding ensures the 8px WindowChrome resize borders are ALWAYS active and never blocked by WebView2 -->
    <Border Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1.5" CornerRadius="8" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Custom Header / Title Bar (Always Draggable) -->
                <RowDefinition x:Name="TitleBarRow" Height="34"/>
                <!-- Row 1: Address & Bookmark Bar -->
                <RowDefinition x:Name="NavBarRow" Height="Auto"/>
                <!-- Row 2: WebView2 Content -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= ROW 0: CUSTOM TITLE BAR ================= -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="0,0,0,1" CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Drag Grip Handle -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <!-- Dedicated Drag Grip with SizeAll cursor -->
                        <Border Background="{DynamicResource ThemeSurfaceRaised}" CornerRadius="4" Padding="5,2" Margin="0,0,7,0" Cursor="SizeAll" ToolTip="Tahan dan geser untuk memindahkan jendela">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⋮⋮" Foreground="#8A2BE2" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Geser" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Center: Drag Space & Status (Clicking here also drags the window) -->
                    <Grid Grid.Column="1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                        <TextBlock x:Name="StatusText" Text="Siap" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                    </Grid>

                    <!-- Right: Window Actions (HitTestVisible for clicking) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <!-- Mode Mengambang (Pin / Always On Top) -->
                        <Button x:Name="PinButton" Style="{StaticResource NavButtonStyle}" ToolTip="Mode Mengambang (Selalu di Atas Jendela Lain)" Click="PinButton_Click" Padding="5,3" Margin="0,0,2,0">
                            <icons:IconPath Kind="Pin" Width="12" Height="12" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Pilihan Ukuran Cepat Preset -->
                        <Button x:Name="PresetSizeButton" Style="{StaticResource NavButtonStyle}" ToolTip="Ubah Ukuran Jendela (Mini PiP, Sedang, HD)" Click="PresetSizeButton_Click" Padding="5,3" Margin="0,0,2,0">
                            <icons:IconPath Kind="AspectRatio" Width="12" Height="12" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Toggle URL Bar (Hide for Movie/Fullscreen Mode) -->
                        <Button x:Name="ToggleNavButton" Style="{StaticResource NavButtonStyle}" ToolTip="Sembunyikan/Tampilkan Bar Alamat URL (Mode Bioskop)" Click="ToggleNavButton_Click" Padding="5,3" Margin="0,0,4,0">
                            <TextBlock x:Name="ToggleNavIcon" Text="▲" FontSize="10" VerticalAlignment="Center"/>
                        </Button>

                        <Rectangle Width="1" Height="14" Fill="#28283C" Margin="2,0" VerticalAlignment="Center"/>

                        <!-- Window Caption Buttons -->
                        <Button Style="{StaticResource WindowCaptionButtonStyle}" Content="{icons:Icon Minimize}" ToolTip="Minimize" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowCaptionButtonStyle}" Content="{icons:Icon Maximize}" ToolTip="Maximize / Restore" Click="MaximizeButton_Click"/>
                        <Button Style="{StaticResource CloseWindowButtonStyle}" Content="{icons:Icon Close}" ToolTip="Tutup ke latar belakang" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= ROW 1: ADDRESS & NAVIGATION BAR ================= -->
            <Border x:Name="NavBarBorder" Grid.Row="1" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="0,0,0,1" Padding="7,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Nav Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button x:Name="BackButton" Style="{StaticResource NavButtonStyle}" Content="{icons:Icon ChevronLeft}" ToolTip="Kembali" Click="BackButton_Click" IsEnabled="False" Width="26" Height="26" Padding="0"/>
                        <Button x:Name="ForwardButton" Style="{StaticResource NavButtonStyle}" Content="{icons:Icon ChevronRight}" ToolTip="Maju" Click="ForwardButton_Click" IsEnabled="False" Width="26" Height="26" Padding="0"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="⟳" ToolTip="Muat Ulang (Refresh)" Click="ReloadButton_Click" Width="26" Height="26" Padding="0"/>
                        <Button Style="{StaticResource NavButtonStyle}" Content="{icons:Icon Home}" ToolTip="Beranda YouTube" Click="HomeButton_Click" Width="26" Height="26" Padding="0"/>
                    </StackPanel>

                    <!-- Center: Omnibox Address Bar -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1" CornerRadius="6" Height="28" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" Margin="7,0,4,0" VerticalAlignment="Center"/>

                            <TextBox x:Name="AddressTextBox" Grid.Column="1"
                                     Background="Transparent" Foreground="{DynamicResource ThemeTextBody}"
                                     BorderThickness="0" FontSize="11.5" VerticalAlignment="Center"
                                     Padding="3,0" CaretBrush="#8A2BE2"
                                     KeyDown="AddressTextBox_KeyDown"/>

                            <Button Grid.Column="2" Style="{StaticResource NavButtonStyle}" Content="{icons:Icon ArrowForward}" ToolTip="Kunjungi / Cari" Click="GoButton_Click" Width="24" Height="24" Padding="0" Margin="0,0,2,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= ROW 2: MAIN CONTENT (WEBVIEW2) ================= -->
            <Grid Grid.Row="2" Background="{DynamicResource ThemeSurfaceDeep}">
                <!-- Loading Indicator -->
                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                    <TextBlock Text="Menyiapkan Browser Mengambang..." Foreground="{DynamicResource ThemeText}" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <ProgressBar IsIndeterminate="True" Width="180" Height="3.5" Foreground="#8A2BE2" Background="{DynamicResource ThemeSurfaceRaised}" BorderThickness="0"/>
                </StackPanel>

                <!-- WebView2 Control -->
                <wv2:WebView2 x:Name="webView"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Visibility="Hidden"/>

                <!-- Bottom-Right Subtle Resize Grip Indicator -->
                <TextBlock Text="⋰" Foreground="{DynamicResource ThemeTextMuted}" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Margin="0,0,3,1" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Border>
</Window>
