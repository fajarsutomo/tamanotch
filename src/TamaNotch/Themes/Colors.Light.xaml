<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema Light: kunci brush semantik yang sama di Colors.Dark/Light/Glass.xaml (dicek oleh ThemeTests). -->

    <!-- Permukaan -->
    <SolidColorBrush x:Key="ThemeSurfaceDeep" Color="#E4E6EE"/>
    <SolidColorBrush x:Key="ThemeSurface" Color="#F2F3F7"/>
    <SolidColorBrush x:Key="ThemeSurfaceRaised" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ThemeSurfaceHigh" Color="#D9DCE6"/>
    <!-- Garis -->
    <SolidColorBrush x:Key="ThemeLine" Color="#D5D8E2"/>
    <SolidColorBrush x:Key="ThemeLineStrong" Color="#B3B9CA"/>
    <!-- Teks -->
    <SolidColorBrush x:Key="ThemeText" Color="#14161C"/>
    <SolidColorBrush x:Key="ThemeTextBody" Color="#2B2F3A"/>
    <SolidColorBrush x:Key="ThemeTextSecondary" Color="#5B6172"/>
    <SolidColorBrush x:Key="ThemeTextMuted" Color="#8A90A2"/>
    <!-- Island (notch) -->
    <SolidColorBrush x:Key="ThemeIslandBg" Color="#FAFAFC"/>
    <SolidColorBrush x:Key="ThemeIslandIdleBg" Color="#FAFAFC"/>

    <!-- Pil, lencana ikon, dan bingkai island -->
    <!-- Flat (Material): semua warna polos, tanpa gradien logam -->
    <SolidColorBrush x:Key="LuxuryNotchBorderBrush" Color="#C9CDDA"/>
    <SolidColorBrush x:Key="LuxuryPillBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MetallicIconBadgeBgBrush" Color="#EEF0F5"/>
    <SolidColorBrush x:Key="MetallicIconBadgeBorderBrush" Color="#D5D9E3"/>
    <SolidColorBrush x:Key="NotchPillBorderBrush" Color="#D0D4E0"/>
    <SolidColorBrush x:Key="NotchPillHoverBorderBrush" Color="#9AA2BA"/>
    <SolidColorBrush x:Key="NotchBadgeHoverBorderBrush" Color="#60000000"/>

    <!-- Warna isi ikon vektor (nama lama dipertahankan; kini polos) -->
    <SolidColorBrush x:Key="MetallicSilverBrush" Color="#3C4150"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollBar.Thumb.Normal" Color="#C4C8D4"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb.MouseOver" Color="#A7ACBD"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb.Pressed" Color="#8A90A2"/>
    <SolidColorBrush x:Key="ScrollBar.Track.Background" Color="#E4E6EE"/>
</ResourceDictionary>
