<Window x:Class="NotchMusic.Views.ClaudeUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NotchMusic.Helpers"
        xmlns:views="clr-namespace:NotchMusic.Views"
        Title="TAMANOTCH - Pemakaian Claude"
        Width="380" MinWidth="320"
        SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="#FFFFFF"
        Topmost="{Binding Settings.AlwaysOnTop}"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>

        <LinearGradientBrush x:Key="MetallicSilverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#E2E6F0" Offset="0.35"/>
            <GradientStop Color="#949BA8" Offset="0.72"/>
            <GradientStop Color="#D4D9E6" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Pengukur kuota (24x24): busur dengan jarum -->
        <Geometry x:Key="ClaudeUsageIconGeometry">M4,17 A8,8 0 1 1 20,17 M12,13 L16,8.5</Geometry>

        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E26"/>
            <Setter Property="Foreground" Value="#E0E0EC"/>
            <Setter Property="BorderBrush" Value="#303042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2C2C3C"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#4C4C66"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="#0A0A0E"
                BorderBrush="#262634"
                BorderThickness="1.2"
                CornerRadius="20"
                MouseDown="Border_MouseDown">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="5" BlurRadius="18" Opacity="0.75"/>
            </Border.Effect>

            <StackPanel Margin="16,14,16,14">

                <!-- HEADER -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="8" Background="#1C1C26" BorderBrush="#38FFFFFF" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource ClaudeUsageIconGeometry}" Stroke="{StaticResource MetallicSilverBrush}" StrokeThickness="1.6"
                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Pemakaian Claude" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="{Binding ClaudeUsagePlanText}" FontSize="10.5" Foreground="#88889C" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding RefreshClaudeUsageCommand}"
                                Content="&#x21BB;" ToolTip="Segarkan sekarang" Margin="0,0,3,0"
                                Visibility="{Binding EnableClaudeUsage, Converter={StaticResource BoolToVis}}"/>
                        <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click"
                                Content="&#x2715;" ToolTip="Sembunyikan jendela"/>
                    </StackPanel>
                </Grid>

                <!-- BELUM DIAKTIFKAN: penjelasan dan persetujuan -->
                <Border Background="#13131B" BorderBrush="#282838" BorderThickness="1.2" CornerRadius="14" Padding="14,12"
                        Visibility="{Binding IsClaudeUsageDisabled, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Pantau kuota sesi 5 jam dan mingguan paket Claude Anda tanpa membuka claude.ai."
                                   FontSize="12" Foreground="#E0E0EC" TextWrapping="Wrap"/>
                        <TextBlock FontSize="10.5" Foreground="#9A9AB0" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Cara kerja: TAMANOTCH membaca token login yang sudah disimpan Claude Code di komputer ini (hanya dibaca, tidak diubah) dan memanggil layanan usage milik Anthropic. Endpoint ini tidak terdokumentasi resmi dan penggunaan token di aplikasi pihak ketiga bisa tidak sejalan dengan ketentuan Anthropic. Aktifkan hanya bila Anda menerima risikonya."/>
                        <Button Style="{StaticResource SmallPillButton}" Command="{Binding EnableClaudeUsageCommand}"
                                Content="Aktifkan pemantauan" Margin="0,12,0,0" Padding="12,7" HorizontalAlignment="Left"
                                Background="#FFFFFF" BorderBrush="#FFFFFF" Foreground="#000000"/>
                    </StackPanel>
                </Border>

                <!-- PESAN STATUS -->
                <Border Background="#2A1E14" BorderBrush="#4A3320" BorderThickness="1.2" CornerRadius="12" Padding="12,9" Margin="0,0,0,10"
                        Visibility="{Binding HasClaudeUsageStatus, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding ClaudeUsageStatusText}" FontSize="11" Foreground="#FFC88A" TextWrapping="Wrap"/>
                </Border>

                <!-- BAR KUOTA -->
                <ItemsControl ItemsSource="{Binding ClaudeUsageBars}"
                              Visibility="{Binding HasClaudeUsageData, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,14">
                                <Grid>
                                    <TextBlock Text="{Binding Label}" FontSize="12.5" FontWeight="SemiBold" Foreground="#F2F2F8"/>
                                    <TextBlock Text="{Binding PercentText}" FontSize="12.5" FontWeight="Bold" Foreground="{Binding Brush}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                                <views:ClaudeUsageBar Margin="0,6,0,0" Percent="{Binding Percent}" Elapsed="{Binding Elapsed}" Fill="{Binding Brush}"/>
                                <TextBlock Text="{Binding ResetText}" FontSize="10.5" Foreground="#88889C" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- SUMBER PEMAKAIAN MINGGU INI -->
                <StackPanel Margin="0,0,0,10"
                            Visibility="{Binding HasClaudeUsageShares, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="SUMBER PEMAKAIAN MINGGU INI" FontSize="8.5" FontWeight="Bold" Foreground="#7A7A90" Margin="0,0,0,4"/>
                    <ItemsControl ItemsSource="{Binding ClaudeUsageShares}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1A1A24" BorderBrush="#2A2A38" BorderThickness="1" CornerRadius="8" Padding="8,3" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#D0D0E0"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- FOOTER -->
                <TextBlock Text="{Binding ClaudeUsageUpdatedText}" FontSize="10.5" Foreground="#6E6E84"
                           Visibility="{Binding HasClaudeUsageData, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="Garis putih pada bar = seberapa jauh periode sudah berjalan. Bar yang melewatinya berarti pemakaian lebih cepat dari waktu."
                           FontSize="9.5" Foreground="#55556A" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasClaudeUsageData, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
