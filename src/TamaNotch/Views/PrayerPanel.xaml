<UserControl x:Class="TamaNotch.Views.PrayerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:TamaNotch.Helpers"
             xmlns:helpers="clr-namespace:TamaNotch.Helpers"
             xmlns:views="clr-namespace:TamaNotch.Views"
             Foreground="{DynamicResource ThemeText}">
    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>



        <!-- Small Pill Button Style -->
        <Style x:Key="SmallPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ================= MODE 1: COMPACT PRAYER NOTCH ================= -->
        <Grid x:Name="PrayerCompactView"
              Visibility="{Binding IsPrayerWindowCompact, Converter={StaticResource BoolToVis}}"
              Height="48" Margin="8,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon Badge -->
            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Margin="2,0,8,0" 
                    Background="{DynamicResource ThemeSurface}" BorderBrush="#38FFFFFF" BorderThickness="1">
                <Path Data="{DynamicResource LuxuryPrayerIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                      Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Next Prayer Pill / Info (Click to Expand) -->
            <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1.2"
                    CornerRadius="12" Height="32" Margin="0,0,6,0" Padding="8,2" Cursor="Hand"
                    ToolTip="{Binding PrayerScheduleTooltip}">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ExpandPrayerWindowCommand}"/>
                </Border.InputBindings>
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding NextPrayerName}" Foreground="{DynamicResource ThemeText}" 
                               FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding NextPrayerTimeFormatted}" Foreground="{DynamicResource ThemeTextBody}" 
                               FontSize="11.5" VerticalAlignment="Center" Margin="0,0,5,0"/>

                    <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" CornerRadius="4" Padding="4,1" 
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding NextPrayerCountdownBadge}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="9.5"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Actions (Expand, Pasang ke Notch, Close) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SmallPillButton}" Command="{Binding ExpandPrayerWindowCommand}" Content="{icons:Icon ChevronDown}" Foreground="{DynamicResource ThemeText}" ToolTip="Perluas Jadwal"/>
                <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachPrayerCommand}" ToolTip="Pasang kembali ke notch utama" Margin="2,0,0,0"
                        Visibility="{Binding IsPrayerDetached, Converter={StaticResource BoolToVis}}">
                    <icons:IconPath Kind="Dock" Width="12" Height="12" Fill="{DynamicResource ThemeText}"/>
                </Button>
                <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click" Content="{icons:Icon Close}" Foreground="{DynamicResource ThemeText}" ToolTip="Tutup Waktu Sholat" Margin="2,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ================= MODE 2: EXPANDED PRAYER SCHEDULE ================= -->
        <Grid x:Name="PrayerExpandedView"
              Visibility="{Binding IsPrayerWindowExpanded, Converter={StaticResource BoolToVis}}"
              Margin="16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Next Prayer Countdown Card -->
                <RowDefinition Height="Auto"/> <!-- Daily Schedule List -->
                <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
            </Grid.RowDefinitions>

            <!-- Header: Icon, Judul, Kota, Tanggal Hijriah, Pasang, Minimize, Tutup -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource ThemeSurface}" BorderBrush="#38FFFFFF" BorderThickness="1" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Path Data="{DynamicResource LuxuryPrayerIconGeometry}" Fill="{DynamicResource MetallicSilverBrush}"
                                  Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Waktu Sholat" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource ThemeSurface}" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPrayerSchedule.CityName}" Foreground="{DynamicResource ThemeTextBody}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding CurrentPrayerSchedule.HijriDate}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- Tombol Pasang Kembali ke Notch Utama -->
                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding AttachPrayerCommand}"
                            Visibility="{Binding IsPrayerDetached, Converter={StaticResource BoolToVis}}"
                            Content="{icons:Icon Dock}" ToolTip="Pasang kembali Waktu Sholat ke notch utama" Margin="0,0,4,0"/>

                    <!-- Tombol Tutup ke Compact (Minimize) -->
                    <Button Style="{StaticResource SmallPillButton}" Command="{Binding MinimizePrayerWindowCommand}"
                            Content="{icons:Icon ChevronUp}" ToolTip="Tutup ke Compact" Margin="0,0,4,0"/>

                    <!-- Tombol Tutup / Sembunyikan -->
                    <Button Style="{StaticResource SmallPillButton}" Click="CloseButton_Click"
                            Content="{icons:Icon Close}" ToolTip="Tutup jendela Waktu Sholat"/>
                </StackPanel>
            </Grid>

            <!-- Next Prayer Countdown Banner Card -->
            <Border Grid.Row="1" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1.2" 
                    CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="WAKTU BERIKUTNYA" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NextPrayerName}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding NextPrayerTimeFormatted}" FontSize="18" FontWeight="Light" Foreground="{DynamicResource ThemeTextBody}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceRaised}" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="HITUNG MUNDUR" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource ThemeTextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding NextPrayerCountdownBadge}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Schedule Cards Grid (Imsak, Subuh, Terbit, Dzuhur, Ashar, Maghrib, Isya) -->
            <Border Grid.Row="2" Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="10" Padding="8,6" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding CurrentPrayerSchedule.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8" Padding="10,6" Margin="0,2,0,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" Text="{Binding FormattedTime}" FontSize="13" FontWeight="Bold" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                            <Setter Property="FontSize" Value="13.5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Border Grid.Column="2" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CountdownText}" FontSize="10" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource ThemeTextMuted}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </Border>

            <!-- Bottom Status & Actions -->
            <Grid Grid.Row="3" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Pilihan Suara Adzan Terpilih & Preview -->
                <Border Grid.Column="0" Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1" CornerRadius="8" Padding="7,4" Margin="0,0,6,0">
                    <StackPanel>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Suara: " Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedAdhanSoundName}" ToolTip="{Binding SelectedAdhanSoundName}" Foreground="{DynamicResource ThemeTextBody}" FontSize="10.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,4,0"/>

                            <!-- Pause / Resume saat playing -->
                            <Button Grid.Column="2" Style="{StaticResource SmallPillButton}" Command="{Binding ToggleAdhanPlayPauseCommand}"
                                    Visibility="{Binding IsAdhanPlaying, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Jeda / Lanjutkan" Padding="6,2" Margin="0,0,3,0">
                                <TextBlock Text="{Binding AdhanPlayPauseButtonIcon}" Foreground="{DynamicResource ThemeText}" FontSize="9"/>
                            </Button>

                            <!-- Tombol Tes / Stop (Hanya Icon) -->
                            <Button Grid.Column="3" Style="{StaticResource SmallPillButton}" Command="{Binding PlayAdhanPreviewCommand}"
                                    ToolTip="{Binding AdhanPlayButtonTooltip}" Padding="6,2" Margin="0">
                                <TextBlock Text="{Binding AdhanPlayButtonIcon}" Foreground="{DynamicResource ThemeText}" FontSize="9"/>
                            </Button>
                        </Grid>

                        <!-- Mini Player Bar saat tes suara sedang berbunyi -->
                        <Grid Visibility="{Binding IsAdhanPlaying, Converter={StaticResource BoolToVis}}" Margin="0,4,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Height="4" Minimum="0" Maximum="100" Value="{Binding AdhanProgressPercent, Mode=OneWay}"
                                         Background="{DynamicResource ThemeSurfaceRaised}" Foreground="#00E676" BorderThickness="0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding AdhanProgressText}" Foreground="#00E676" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Button Grid.Column="1" Style="{StaticResource SmallPillButton}" Command="{Binding OpenSettingsCommand}" 
                        Content="⚙ Pengaturan" Padding="8,4"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
