<Window x:Class="TamaNotch.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:TamaNotch.Helpers"
        xmlns:helpers="clr-namespace:TamaNotch.Helpers"
        Title="Pengaturan TAMANOTCH" Height="640" Width="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeTextBody}"
        ResizeMode="NoResize">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
        <helpers:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <helpers:CategoryVisibilityConverter x:Key="CategoryVis"/>
        <helpers:CategoryIconConverter x:Key="CategoryIcon"/>

        <!-- Kartu pengaturan: tampil hanya bila Tag-nya sama dengan kategori terpilih di sidebar -->
        <Style x:Key="CategoryCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Visibility">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource CategoryVis}">
                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                        <Binding Path="SelectedCategory"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item sidebar kategori -->
        <Style x:Key="SidebarItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Kotak teks mengikuti tema (sebelumnya putih polos di semua tema) -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceDeep}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
            <Setter Property="SelectionBrush" Value="#66FFFFFF"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextBody}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Pemilih warna: deretan swatch bulat; yang terpilih diberi cincin putih -->
        <Style x:Key="SwatchListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SelectedValuePath" Value="Hex"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,6"/>
                        <Setter Property="ToolTip" Value="{Binding Name}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid Width="26" Height="26" Cursor="Hand" Background="Transparent">
                                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                                        <Ellipse Margin="4" Fill="{Binding SwatchHex}"/>
                                        <TextBlock Text="&#x21BA;" Foreground="{DynamicResource ThemeTextBody}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="#80FFFFFF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource ThemeTextBody}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- High-Contrast Dark ComboBox & ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeLineStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="22"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource ThemeText}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource ThemeSurfaceHigh}"/>
                                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#686884"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,2,22,2"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource ThemeText}"
                                              TextElement.FontWeight="Bold">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource ThemeSurface}"
                                            BorderBrush="{DynamicResource ThemeLineStrong}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Pengaturan TAMANOTCH" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
            <TextBlock Text="Sesuaikan panel TAMANOTCH dan integrasi lirik" Margin="0,4,0,0" Foreground="{DynamicResource ThemeTextSecondary}"/>
        </StackPanel>

        <!-- Sidebar kategori + konten -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="CategoryList" ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource SidebarItem}"
                     Background="Transparent" BorderThickness="0" Margin="0,0,14,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <icons:IconPath Kind="{Binding Converter={StaticResource CategoryIcon}}" Width="17" Height="17"
                                            VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. Pembaruan Aplikasi (Auto-Update) - Di Paling Atas -->
                <Border Style="{StaticResource CategoryCard}" Tag="Pembaruan">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Pembaruan Aplikasi (Update)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="{Binding CurrentVersion, StringFormat='Versi aplikasi saat ini: v{0}'}" 
                                           FontSize="11.5" Foreground="{DynamicResource ThemeText}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Periksa Pembaruan" Command="{Binding CheckUpdateCommand}"
                                    IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolToVis}}"
                                    Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="12,6" Cursor="Hand" VerticalAlignment="Center"/>
                        </Grid>

                        <CheckBox Content="Periksa pembaruan otomatis saat aplikasi dijalankan" IsChecked="{Binding AutoCheckUpdates}"/>

                        <!-- Status Text -->
                        <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource ThemeTextBody}" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding UpdateStatus, Converter={StaticResource StringNotEmptyToVis}}"/>

                        <!-- Update Tersedia Panel -->
                        <Border Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}"
                                Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding AvailableUpdate.Title}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" FontSize="13"/>
                                        <TextBlock Text="{Binding AvailableUpdate.UpdateTypeLabel}" FontSize="11" Foreground="{DynamicResource ThemeTextBody}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding AvailableUpdate.Version, StringFormat='v{0}'}" 
                                               FontWeight="Bold" Foreground="{DynamicResource ThemeText}" FontSize="14" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Changelog -->
                                <TextBlock Text="Catatan Pembaruan:" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,2"/>
                                <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="4" Padding="8" MaxHeight="100" Margin="0,0,0,8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding AvailableUpdate.Changelog}" FontSize="11" Foreground="{DynamicResource ThemeTextBody}" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>

                                <!-- Download Progress Bar -->
                                <StackPanel Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="Mengunduh installer pembaruan..." FontSize="11" Foreground="{DynamicResource ThemeTextBody}"/>
                                        <TextBlock Text="{Binding DownloadProgress, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100" Height="6" Foreground="{DynamicResource ThemeText}" Background="{DynamicResource ThemeSurfaceDeep}" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Tombol Aksi Update -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Update Sekarang (Unduh &amp; Pasang)" Command="{Binding DownloadAndInstallUpdateCommand}"
                                            IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBoolToVis}}"
                                            Background="#FFFFFF" Foreground="#000000" FontWeight="SemiBold" BorderThickness="0" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
                                    <Button Content="Buka Halaman Rilis" Command="{Binding OpenReleasePageCommand}"
                                            Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="12,6" Cursor="Hand"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 2. Tampilan & Perilaku -->
                <Border Style="{StaticResource CategoryCard}" Tag="Umum">
                    <StackPanel>
                        <TextBlock Text="Tampilan &amp; Perilaku" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <CheckBox Content="Jalankan otomatis saat login Windows" IsChecked="{Binding StartWithWindows}"/>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Posisi notch (geser kiri/kanan dari tengah layar):" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding NotchHorizontalOffsetText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                        </Grid>
                        <Slider Minimum="-50" Maximum="50" Value="{Binding NotchHorizontalOffsetPercent}"
                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5" Margin="0,2,0,4"/>
                        <Button Content="Kembalikan ke Tengah" Command="{Binding ResetNotchPositionCommand}"
                                Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="10,5"
                                HorizontalAlignment="Left" Cursor="Hand"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ukuran mata saat idle:" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding IdleIconSizeText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                        </Grid>
                        <Slider Minimum="24" Maximum="48" Value="{Binding IdleIconSize}"
                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tema tampilan -->
                <Border Style="{StaticResource CategoryCard}" Tag="Tema">
                    <StackPanel>
                        <TextBlock Text="Tema Tampilan" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <TextBlock Text="Berlaku untuk island, Pengaturan, dan semua jendela. Warna neon notch diatur terpisah di Tampilan Notch."
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>
                        <ComboBox ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectedValue="{Binding AppTheme, Mode=TwoWay}" Width="220" HorizontalAlignment="Left" Height="28"/>
                        <TextBlock Text="Gelap: tampilan bawaan. Putih: permukaan terang. Liquid Glass: kaca bening dengan blur latar seperti macOS (atur di bawah)."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Liquid Glass lanjutan -->
                <Border Style="{StaticResource CategoryCard}" Tag="Tema">
                    <StackPanel IsEnabled="{Binding IsGlassTheme}">
                        <TextBlock Text="Liquid Glass Lanjutan" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,4"/>
                        <TextBlock Text="Aktif bila tema Liquid Glass dipilih. Perubahan langsung terlihat di island."
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>

                        <CheckBox Content="Blur latar island" IsChecked="{Binding GlassIslandBlur}" Margin="0,0,0,2"/>
                        <TextBlock Text="Latar di belakang island disalin dan di-blur. Selama aktif, island tidak tampak di screenshot, rekaman, atau berbagi layar (Teams/Zoom). Matikan bila island perlu terlihat saat presentasi; island menjadi kaca polos tanpa blur."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="22,0,0,10"/>

                        <StackPanel IsEnabled="{Binding GlassIslandBlur}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Kekuatan blur:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding GlassBlurStrengthText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            </Grid>
                            <Slider Minimum="1" Maximum="10" Value="{Binding GlassBlurStrength}"
                                    TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2" Margin="0,2,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Warna kaca island (kepekatan):" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding GlassTintPercentText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="80" Value="{Binding GlassTintPercent}"
                                    TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="10" Margin="0,2,0,4"/>
                            <TextBlock Text="Makin kecil makin bening. Tombol dan pil di dalam island tidak terpengaruh."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,8"/>

                            <CheckBox Content="Sesuaikan otomatis dengan terang latar" IsChecked="{Binding GlassAdaptiveTint}" Margin="0,0,0,2"/>
                            <TextBlock Text="Kaca menebal di atas latar terang (mis. halaman web putih) agar teks putih tetap terbaca."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="22,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Pembaruan latar:" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding GlassRefreshText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            </Grid>
                            <Slider Minimum="100" Maximum="1000" Value="{Binding GlassRefreshMs}"
                                    TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="100" Margin="0,2,0,4"/>
                            <TextBlock Text="Lebih cepat = latar video/gulir lebih mengikuti, tetapi sedikit lebih banyak CPU."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,0,0,10"/>
                        </StackPanel>

                        <CheckBox Content="Blur jendela lain (Radio, Al-Qur'an, BMKG, Pengaturan, ...)" IsChecked="{Binding GlassWindowBlur}" Margin="0,0,0,2"/>
                        <TextBlock Text="Memakai blur bawaan Windows; jendela tetap terlihat saat berbagi layar."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextMuted}" Margin="22,0,0,10"/>

                        <Button Content="Kembalikan ke Bawaan" Command="{Binding ResetGlassCommand}"
                                Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="10,5"
                                HorizontalAlignment="Left" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- Mode tampil komponen: jendela sendiri atau tertanam di island -->
                <Border Style="{StaticResource CategoryCard}" Tag="Tampilan Notch">
                    <StackPanel>
                        <TextBlock Text="Tampil di Island atau Jendela" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <TextBlock Text="Pilih 'Tertanam di island' agar komponen terbuka di dalam island (di antara tombol dan baris info) saat ikonnya ditekan. Dari menu tray, komponen tetap terbuka sebagai jendela."
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Radio" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DisplayModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding RadioDisplayMode, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Height="28" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Al-Qur'an" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding DisplayModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding QuranDisplayMode, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Height="28" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Text="Waktu Sholat" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DisplayModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding PrayerDisplayMode, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Height="28" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Text="Pemakaian Claude" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding DisplayModeChoices}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding ClaudeUsageDisplayMode, Mode=TwoWay}" Width="200" HorizontalAlignment="Left" Height="28"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Sticky note -->
                <Border Style="{StaticResource CategoryCard}" Tag="Sticky Note &amp; Monitor">
                    <StackPanel>
                        <TextBlock Text="Sticky Note" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <CheckBox Content="Tampilkan ikon sticky note di island" IsChecked="{Binding EnableNotes, Mode=TwoWay}"/>
                        <TextBlock Text="Menyimpan akun (user dan password) serta catatan teks bebas; dibuka sebagai panel di island dengan tombol salin per kolom."
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,0"/>
                        <TextBlock Text="Peringatan: isi disimpan sebagai teks biasa (tanpa enkripsi) di berkas di bawah. Jangan membagikan berkas ini; cocok untuk akun intranet, bukan akun publik."
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="#FFB74D" Margin="0,6,0,0"/>
                        <TextBox Text="{Binding NotesFilePath, Mode=OneWay}" IsReadOnly="True" FontSize="11" Margin="0,8,0,0" Padding="6,4"
                                 Background="{DynamicResource ThemeSurfaceDeep}" Foreground="{DynamicResource ThemeTextBody}" BorderBrush="{DynamicResource ThemeLine}"/>
                    </StackPanel>
                </Border>

                <!-- Monitor sistem -->
                <Border Style="{StaticResource CategoryCard}" Tag="Sticky Note &amp; Monitor">
                    <StackPanel>
                        <TextBlock Text="Monitor Sistem" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <CheckBox Content="Tampilkan ikon monitor sistem di island" IsChecked="{Binding EnableSystemMonitor, Mode=TwoWay}"/>
                        <CheckBox Content="Tampilkan uptime komputer di baris info island" IsChecked="{Binding ShowUptimeInIsland, Mode=TwoWay}"/>
                        <TextBlock Text="Grafik CPU, memori, disk, jaringan, dan GPU (seperti tab Performance Task Manager) tampil sebagai panel di island. Pembacaan hanya berjalan selama panel terbuka. Disk dan GPU disembunyikan bila Windows tidak menyediakan datanya."
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Taskbar transparan (TranslucentTB) -->
                <Border Style="{StaticResource CategoryCard}" Tag="Tema">
                    <StackPanel>
                        <TextBlock Text="Taskbar Transparan" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <CheckBox Content="Jalankan TranslucentTB bersama TAMANOTCH" IsChecked="{Binding LaunchTranslucentTb, Mode=TwoWay}"
                                  IsEnabled="{Binding IsTranslucentTbInstalled, Mode=OneWay}"/>
                        <TextBlock Text="Windows 11 terbaru menggambar taskbar dengan XAML sehingga tidak bisa dibuat transparan lewat API biasa. TAMANOTCH tidak mengubah taskbar sendiri; ia hanya menyalakan TranslucentTB otomatis setiap kali TAMANOTCH berjalan, sehingga tidak perlu mengandalkan autostart TranslucentTB. Atur tingkat transparansi di ikon tray TranslucentTB."
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding TranslucentTbStatus, Mode=OneWay}" TextWrapping="Wrap" FontSize="11.5"
                                   Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Kustomisasi Notch -->
                <Border Style="{StaticResource CategoryCard}" Tag="Tampilan Notch">
                    <StackPanel>
                        <TextBlock Text="Kustomisasi Notch" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>

                        <TextBlock Text="Saat idle" FontWeight="SemiBold" Foreground="#CFE8FF" Margin="0,0,0,6"/>
                        <TextBlock Text="Warna mata" FontSize="11.5" Foreground="{DynamicResource ThemeTextBody}" Margin="0,0,0,4"/>
                        <ListBox Style="{StaticResource SwatchListBox}" ItemsSource="{Binding IdlePalette}" SelectedValue="{Binding IdleEyeColor, Mode=TwoWay}"/>

                        <TextBlock Text="Warna frame" FontSize="11.5" Foreground="{DynamicResource ThemeTextBody}" Margin="0,6,0,4"/>
                        <ListBox Style="{StaticResource SwatchListBox}" ItemsSource="{Binding IdlePalette}" SelectedValue="{Binding IdleFrameColor, Mode=TwoWay}"/>

                        <TextBlock Text="Bentuk frame (persegi panjang, sudut bawah dapat dibulatkan)" FontSize="11.5" Foreground="{DynamicResource ThemeTextBody}" Margin="0,6,0,2"/>
                        <CheckBox Content="Ukuran otomatis (mengikuti ukuran mata)" IsChecked="{Binding IdleFrameAutoSize}"/>
                        <StackPanel IsEnabled="{Binding IsIdleFrameSizeEditable}">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Panjang" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding IdleFrameWidthText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            </Grid>
                            <Slider Minimum="40" Maximum="240" Value="{Binding IdleFrameWidth}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lebar (tinggi)" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding IdleFrameHeightText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            </Grid>
                            <Slider Minimum="20" Maximum="90" Value="{Binding IdleFrameHeight}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"/>
                        </StackPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sudut kiri bawah" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding IdleFrameRadiusLeftText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="60" Value="{Binding IdleFrameRadiusLeft}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sudut kanan bawah" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding IdleFrameRadiusRightText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                        </Grid>
                        <Slider Minimum="0" Maximum="60" Value="{Binding IdleFrameRadiusRight}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"/>

                        <CheckBox Content="Bentuk air menggantung (sudut atas melengkung terbalik ke tepi layar; berlaku juga untuk island)"
                                  IsChecked="{Binding IdleDropShape}" Margin="0,10,0,0"/>
                        <StackPanel IsEnabled="{Binding IsIdleTopRadiusEditable}">
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sudut kiri atas" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding IdleTopRadiusLeftText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="16" Value="{Binding IdleTopRadiusLeft}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sudut kanan atas" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding IdleTopRadiusRightText}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="16" Value="{Binding IdleTopRadiusRight}" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2"/>
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource ThemeSurfaceHigh}" Margin="0,12,0,12"/>

                        <TextBlock Text="Saat hover (dynamic island)" FontWeight="SemiBold" Foreground="#CFE8FF" Margin="0,0,0,6"/>
                        <CheckBox Content="Samakan dengan notch idle" IsChecked="{Binding HoverSameAsIdle}"/>
                        <TextBlock Text="Warna frame" FontSize="11.5" Foreground="{DynamicResource ThemeTextBody}" Margin="0,6,0,4"/>
                        <ListBox Style="{StaticResource SwatchListBox}" ItemsSource="{Binding HoverPalette}" SelectedValue="{Binding HoverFrameColor, Mode=TwoWay}"
                                 IsEnabled="{Binding IsHoverColorEditable}"/>
                        <TextBlock Text="Warna cincin ikon saat disorot kursor" FontSize="11.5" Foreground="{DynamicResource ThemeTextBody}" Margin="0,6,0,4"/>
                        <ListBox Style="{StaticResource SwatchListBox}" ItemsSource="{Binding HoverPalette}" SelectedValue="{Binding HoverRingColor, Mode=TwoWay}"
                                 IsEnabled="{Binding IsHoverColorEditable}"/>
                        <TextBlock Text="Ikon &#x21BA; = tampilan bawaan." FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Pengingat Kesehatan -->
                <Border Style="{StaticResource CategoryCard}" Tag="Kesehatan">
                    <StackPanel>
                        <TextBlock Text="Pengingat Kesehatan" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <TextBlock Text="Pengingat hanya muncul pada jam kerja, dan tidak saat Anda sedang pergi dari komputer. Pergi lebih dari 2 menit dihitung sebagai jeda gerak."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>

                        <!-- Gerak -->
                        <CheckBox Content="Ingatkan saya untuk bergerak (berdiri, jalan, peregangan)" IsChecked="{Binding MoveReminderEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="22,2,0,10">
                            <TextBlock Text="Setiap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding MoveIntervalOptions}" SelectedItem="{Binding MoveReminderMinutes}"
                                      ItemStringFormat="{}{0} menit" Width="110" Height="26"/>
                        </StackPanel>

                        <!-- Minum -->
                        <CheckBox Content="Ingatkan saya untuk minum" IsChecked="{Binding DrinkReminderEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="22,2,0,4">
                            <TextBlock Text="Setiap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding DrinkIntervalOptions}" SelectedItem="{Binding DrinkReminderMinutes}"
                                      ItemStringFormat="{}{0} menit" Width="110" Height="26" Margin="0,0,14,0"/>
                            <TextBlock Text="Ukuran gelas" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding GlassSizeOptions}" SelectedItem="{Binding DrinkGlassMl}"
                                      ItemStringFormat="{}{0} ml" Width="90" Height="26"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="22,4,0,4">
                            <TextBlock Text="Target harian" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding GlassGoalOptions}" SelectedItem="{Binding DrinkDailyGoalGlasses}"
                                      ItemStringFormat="{}{0} gelas" Width="110" Height="26"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="22,4,0,10">
                            <TextBlock Text="{Binding DrinkProgressText}" Foreground="#8FD0A5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="+ Catat 1 gelas" Command="{Binding LogDrinkCommand}"
                                    Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="10,4" Margin="0,0,6,0" Cursor="Hand"/>
                            <Button Content="Reset" Command="{Binding ResetDrinkCountCommand}"
                                    Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="10,4" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Jam kerja & suara -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Jam kerja" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding WorkTimeOptions}" SelectedItem="{Binding ReminderWorkStart}" Width="80" Height="26"/>
                            <TextBlock Text="sampai" VerticalAlignment="Center" Margin="8,0"/>
                            <ComboBox ItemsSource="{Binding WorkTimeOptions}" SelectedItem="{Binding ReminderWorkEnd}" Width="80" Height="26"/>
                        </StackPanel>
                        <CheckBox Content="Bunyikan nada notifikasi" IsChecked="{Binding ReminderSoundEnabled}"/>

                        <TextBlock Text="Interval bawaan (gerak 45 menit, minum 60 menit, 8 gelas x 230 ml) adalah titik awal yang wajar, bukan anjuran medis. Kebutuhan air berbeda tiap orang; bila Anda memiliki pembatasan cairan, ikuti arahan dokter."
                                   TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DNS-over-HTTPS -->
                <Border Style="{StaticResource CategoryCard}" Tag="Sinkronisasi &amp; Jaringan">
                    <StackPanel>
                        <TextBlock Text="DNS publik (DoH) untuk jendela web" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <TextBlock Text="Jendela pemutar (Jellyfin, Spotify, YouTube Music, Live TV, browser) me-resolve alamat https lewat DNS-over-HTTPS publik, tidak lewat DNS Windows atau jaringan. Berguna bila DNS jaringan tidak bisa me-resolve alamat Anda. Pengaturan Windows tidak diubah. Berlaku setelah TAMANOTCH dimulai ulang; log di %LOCALAPPDATA%\TAMANOTCH\doh.log."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                        <CheckBox Content="Pakai DNS-over-HTTPS publik" IsChecked="{Binding DohEnabled}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Penyedia utama:" Foreground="{DynamicResource ThemeTextBody}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding DohProviders}" SelectedItem="{Binding DohProvider}" Width="140"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Jellyfin -->
                <Border Style="{StaticResource CategoryCard}" Tag="Musik &amp; Media">
                    <StackPanel>
                        <TextBlock Text="Jellyfin" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <TextBlock Text="Alamat server Jellyfin untuk jendela pemutar Jellyfin (tombol segitiga di notch atau menu tray). Login tersimpan di profil jendela."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding JellyfinUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource ThemeSurfaceDeep}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeLineStrong}" Padding="6,4" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Tes koneksi" Command="{Binding CheckJellyfinCommand}"
                                    IsEnabled="{Binding IsCheckingJellyfin, Converter={StaticResource InverseBoolToVis}}"
                                    Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="12,4" Cursor="Hand"/>
                        </Grid>
                        <TextBlock Text="{Binding JellyfinResolvedUrl, StringFormat='Dipakai: {0}'}" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding JellyfinStatus}" FontSize="11" Foreground="#8FD0A5" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding JellyfinStatus, Converter={StaticResource StringNotEmptyToVis}}"/>
                        <Button Content="Kembalikan ke alamat bawaan" Command="{Binding ResetJellyfinUrlCommand}"
                                Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0" Padding="0,6,0,0"
                                HorizontalAlignment="Left" Cursor="Hand" FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Tentang -->
                <Border Style="{StaticResource CategoryCard}" Tag="Umum">
                    <StackPanel>
                        <TextBlock Text="Tentang TAMANOTCH" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <TextBlock Text="TAMANOTCH menghadirkan pengalaman Dynamic Island di bagian atas desktop Windows untuk menunjang hiburan dan produktivitas: pemutar musik &amp; lirik, radio, Live TV, waktu sholat, cuaca &amp; gempa BMKG, to-do list, dan browser mengambang."
                                   TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource ThemeTextBody}"/>
                        <TextBlock Text="{Binding CurrentVersion, StringFormat='Versi: v{0}'}" FontSize="11.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. Lirik -->
                <Border Style="{StaticResource CategoryCard}" Tag="Musik &amp; Media">
                    <StackPanel>
                        <TextBlock Text="Lirik &amp; Integrasi LRCLIB" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,8"/>
                        <CheckBox Content="Cari lirik otomatis di LRCLIB saat lagu berganti" IsChecked="{Binding AutoSearchLyrics}"/>
                        
                        <TextBlock Text="Catatan privasi: Pencarian mengirim metadata lagu (judul, artis, album) ke API publik LRCLIB." 
                                   TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,4,0,10"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ukuran font lirik (Mode Lyrics):" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LyricsFontSize, StringFormat={}{0:0} pt}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                        </Grid>
                        <Slider Minimum="12" Maximum="32" Value="{Binding LyricsFontSize}" Margin="0,2,0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Transparansi latar belakang lirik:" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LyricsOpacity, StringFormat={}{0:P0}}" FontWeight="Bold" Foreground="{DynamicResource ThemeText}"/>
                        </Grid>
                        <Slider Minimum="0.3" Maximum="1.0" Value="{Binding LyricsOpacity}" Margin="0,2,0,8"/>

                        <Button Content="Bersihkan Cache Lirik" Command="{Binding ClearCacheCommand}" 
                                Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="10,6" Margin="0,6,0,0"
                                HorizontalAlignment="Left" Cursor="Hand"/>
                    </StackPanel>
                </Border>

                <!-- 4. Integrasi Google Drive (To-Do List Cloud Sync) -->
                <Border Style="{StaticResource CategoryCard}" Tag="Sinkronisasi &amp; Jaringan">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sinkronisasi Google Drive (To-Do List)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="Sinkronkan to-do list antar komputer / laptop lewat Google Drive" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                            
                            <!-- Status Indicator Badge -->
                            <Border Grid.Column="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource ThemeSurface}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ThemeSurfaceRaised}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Belum Terhubung"/>
                                            <Setter Property="Foreground" Value="#FFAEAE"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGoogleDriveConnected}" Value="True">
                                                    <Setter Property="Text" Value="&#x2713; Terhubung"/>
                                                    <Setter Property="Foreground" Value="#81C784"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- Saat SUDAH Terhubung -->
                        <StackPanel Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                            <TextBlock Text="{Binding GoogleDriveUserEmail, StringFormat='Akun Google: {0}'}" FontWeight="Medium" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding GoogleDriveLastSyncFormatted, StringFormat='Terakhir sinkron: {0}'}" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,0,0,10"/>

                            <CheckBox Content="Otomatis sinkronkan saat ada perubahan tugas" IsChecked="{Binding GoogleDriveAutoSync}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Sinkronkan Sekarang" Command="{Binding SyncGoogleDriveNowCommand}"
                                        Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                                <Button Content="Putuskan Sambungan" Command="{Binding DisconnectGoogleDriveCommand}"
                                        Background="{DynamicResource ThemeSurfaceRaised}" Foreground="#FF99AA" BorderThickness="0" Padding="12,6" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Saat BELUM Terhubung -->
                        <StackPanel Visibility="{Binding IsGoogleDriveConnected, Converter={StaticResource InverseBoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Text="Login dengan akun Google/Gmail Anda untuk menyinkronkan tugas secara otomatis antar perangkat." 
                                       FontSize="11.5" Foreground="{DynamicResource ThemeTextBody}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock Text="TAMANOTCH tidak membawa kredensial Google. Buat kredensial sendiri (gratis, sekali saja; langkahnya ada di docs/GOOGLE_DRIVE_SETUP.md), lalu impor credentials.json atau isi Client ID dan Secret di bawah. Setelah terisi, tombol Hubungkan aktif."
                                       FontSize="11" Foreground="#FFB020" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Visibility="{Binding IsGoogleDriveConfigured, Converter={StaticResource InverseBoolToVis}}"/>

                            <Button Content="Hubungkan Akun Google" Command="{Binding ConnectGoogleDriveCommand}"
                                    IsEnabled="{Binding IsGoogleDriveConfigured}"
                                    Background="#FFFFFF" Foreground="#000000" FontWeight="SemiBold" BorderThickness="0" Padding="16,8"
                                    HorizontalAlignment="Left" Cursor="Hand"/>

                            <TextBlock Text="{Binding GoogleDriveSyncStatus}" Foreground="{DynamicResource ThemeTextBody}" FontSize="11" Margin="0,6,0,8"/>

                            <!-- Opsi Kredensial Kustom (Opsional) -->
                            <Button Content="Kredensial Google (Client ID &amp; Secret) &#x25BE;" Command="{Binding ToggleCustomCredentialsCommand}"
                                    Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0" Padding="0,4"
                                    HorizontalAlignment="Left" Cursor="Hand" FontSize="11"/>

                            <StackPanel Visibility="{Binding ShowCustomCredentials, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                                <TextBlock Text="Impor file credentials.json dari project Google Cloud Anda, atau masukkan Client ID dan Secret-nya:" 
                                           FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <Button Content="Impor File credentials.json" Command="{Binding ImportCredentialsCommand}"
                                        Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="10,5"
                                        HorizontalAlignment="Left" Cursor="Hand" Margin="0,0,0,8"/>

                                <TextBlock Text="Client ID:" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2"/>
                                <TextBox Text="{Binding GoogleDriveClientId, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="{DynamicResource ThemeSurfaceDeep}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeLineStrong}" Padding="5" Margin="0,0,0,6"/>

                                <TextBlock Text="Client Secret:" FontSize="10.5" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2"/>
                                <TextBox Text="{Binding GoogleDriveClientSecret, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="{DynamicResource ThemeSurfaceDeep}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeLineStrong}" Padding="5" Margin="0,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 5. Waktu Sholat & Pengingat (Prayer Times) -->
                <Border Style="{StaticResource CategoryCard}" Tag="Waktu Sholat">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="&#x1F54C; Waktu Sholat &amp; Pengingat" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="Jadwal sholat otomatis, pengingat sebelum &amp; sesudah adzan, dan jeda musik" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Aktifkan fitur Waktu Sholat &amp; Pengingat" IsChecked="{Binding EnablePrayerTimes}"/>

                        <StackPanel Visibility="{Binding EnablePrayerTimes, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <!-- Lokasi / Kota -->
                            <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="6" Padding="10,8" Margin="0,4,0,8">
                                <StackPanel>
                                    <TextBlock Text="Lokasi Kota:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,2,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding IndonesianCities}"
                                                  SelectedItem="{Binding SelectedCity}"
                                                  DisplayMemberPath="DisplayName"
                                                  Margin="0,0,8,0" Height="28"/>
                                        <Button Grid.Column="1" Content="&#x1F4CD; Deteksi Lokasi" Command="{Binding DetectLocationCommand}"
                                                Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="10,4"
                                                Cursor="Hand" ToolTip="Deteksi lokasi kota dan koordinat otomatis lewat IP"/>
                                    </Grid>
                                    <TextBlock Text="{Binding LocationDetectStatus}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10.5"
                                               Visibility="{Binding LocationDetectStatus, Converter={StaticResource StringNotEmptyToVis}}" Margin="0,2,0,4"/>

                                    <!-- Cari lokasi lebih spesifik (kelurahan/desa/kecamatan) -->
                                    <TextBlock Text="Atau cari lokasi lebih spesifik (kelurahan, desa, kecamatan):" Foreground="{DynamicResource ThemeTextBody}" FontSize="11" Margin="0,6,0,4"/>
                                    <Grid Visibility="{Binding CanSearchLocation, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding LocationSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{DynamicResource ThemeSurfaceDeep}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeLineStrong}" Padding="6,4" Margin="0,0,8,0">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding SearchLocationCommand}"/>
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Content="Cari" Command="{Binding SearchLocationCommand}"
                                                IsEnabled="{Binding IsSearchingLocation, Converter={StaticResource InverseBoolToVis}}"
                                                Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="14,4" Cursor="Hand"/>
                                    </Grid>

                                    <Border Visibility="{Binding HasLocationSearchResults, Converter={StaticResource BoolToVis}}"
                                            Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,6,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="2,0,2,4">
                                                <Button DockPanel.Dock="Right" Content="{icons:Icon Close}" Command="{Binding ClearLocationSearchCommand}"
                                                        Background="Transparent" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0" Padding="6,0" Cursor="Hand"/>
                                                <TextBlock Text="Hasil pencarian:" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10.5" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding LocationSearchResults}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Command="{Binding DataContext.SelectLocationResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,3"
                                                                    Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1" HorizontalContentAlignment="Stretch" Padding="8,5">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding DisplayTitle}" Foreground="{DynamicResource ThemeText}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding DisplaySubtitle}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding CurrentLocationText}" Foreground="#8FD0A5" FontSize="11" Margin="0,8,0,2" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding TodayPrayerSchedule.HijriDate, StringFormat='Kalender Hijriah: {0}'}" 
                                               Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11"/>
                                </StackPanel>
                            </Border>

                            <!-- Pengingat Sebelum Sholat -->
                            <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Ingatkan sebelum waktu sholat tiba" 
                                                  IsChecked="{Binding RemindBeforePrayer}" Margin="0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding RemindBeforePrayer, Converter={StaticResource BoolToVis}}">
                                            <ComboBox ItemsSource="{Binding AvailableMinutesOptions}"
                                                      SelectedItem="{Binding RemindBeforeMinutes}"
                                                      Width="60" Height="26" Margin="4,0"/>
                                            <TextBlock Text="menit sebelumnya" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextBody}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Memberikan waktu bersiap-siap wudhu atau menuju masjid sebelum adzan berkumandang." 
                                               FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="22,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Pengingat Saat Masuk Waktu Sholat (Adzan) -->
                            <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox Content="Ingatkan tepat saat masuk waktu sholat (Adzan)" 
                                              IsChecked="{Binding RemindAtPrayerTime}" Margin="0"/>
                                    <TextBlock Text="Menampilkan kartu notifikasi Dynamic Island dan notifikasi Windows saat adzan tiba." 
                                               FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="22,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Pengingat Sesudah Sholat -->
                            <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Ingatkan sesudah waktu sholat berlalu" 
                                                  IsChecked="{Binding RemindAfterPrayer}" Margin="0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding RemindAfterPrayer, Converter={StaticResource BoolToVis}}">
                                            <ComboBox ItemsSource="{Binding AvailableMinutesOptions}"
                                                      SelectedItem="{Binding RemindAfterMinutes}"
                                                      Width="60" Height="26" Margin="4,0"/>
                                            <TextBlock Text="menit sesudahnya" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource ThemeTextBody}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Notifikasi konfirmasi ramah: 'Sudahkah Anda menunaikan sholat?' agar tidak terlewat." 
                                               FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="22,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Puasa: pengingat sahur & berbuka, pengingat minum diam selama berpuasa -->
                            <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox Content="Mode puasa (sahur &amp; berbuka)" IsChecked="{Binding EnableFasting}" Margin="0"/>
                                    <TextBlock Text="Pengingat sahur sebelum Imsak, notifikasi berbuka saat Maghrib, dan pengingat minum berhenti dari Imsak sampai Maghrib."
                                               FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="22,2,0,0" TextWrapping="Wrap"/>
                                    <StackPanel Margin="22,6,0,0" Visibility="{Binding EnableFasting, Converter={StaticResource BoolToVis}}">
                                        <CheckBox Content="Hanya hari Senin dan Kamis (kosongkan untuk setiap hari, mis. Ramadan)"
                                                  IsChecked="{Binding FastingMondayThursdayOnly}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Ingatkan sahur" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" Foreground="{DynamicResource ThemeTextBody}"/>
                                            <ComboBox ItemsSource="{Binding FastingSahurOptions}" SelectedItem="{Binding FastingSahurMinutes}"
                                                      ItemStringFormat="{}{0} menit" Width="110" Height="26"/>
                                            <TextBlock Text="sebelum Imsak" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource ThemeTextBody}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Opsi Suara & Integrasi Musik -->
                            <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" Content="Bunyikan nada dering / chime saat ada pengingat" 
                                                  IsChecked="{Binding PrayerSoundAlert}" Margin="0"/>
                                        <Button Grid.Column="1" Content="&#x1F50A; Tes Suara" Command="{Binding TestPrayerChimeCommand}"
                                                Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="8,3"
                                                Cursor="Hand" FontSize="11"/>
                                    </Grid>
                                    <TextBlock Text="{Binding TestNotificationStatus}" Foreground="#81C784" FontSize="10.5" 
                                               Visibility="{Binding TestNotificationStatus, Converter={StaticResource StringNotEmptyToVis}}" Margin="22,0,0,4"/>

                                    <CheckBox Content="Jeda musik otomatis saat masuk waktu sholat (Auto-Pause)" 
                                              IsChecked="{Binding PrayerAutoPauseMusic}" Margin="0,4"/>
                                    <TextBlock Text="Otomatis menghentikan lagu saat adzan tiba sehingga Anda dapat langsung mendengarkan adzan dan sholat." 
                                               FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="22,0,0,6" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Pilihan Suara Adzan & Notifikasi -->
                            <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Pilihan Suara Adzan:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}" FontSize="11.5"/>
                                            <TextBlock Text="Pilih lantunan suara adzan terbaik saat waktu sholat tiba." Foreground="{DynamicResource ThemeTextMuted}" FontSize="10.5"/>
                                        </StackPanel>
                                        
                                        <!-- Tombol Preview & Stop Suara Adzan -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Command="{Binding PlayAdhanPreviewCommand}" Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}"
                                                    BorderThickness="0" Padding="10,4" Cursor="Hand" FontSize="11">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding AdhanPlayButtonIcon}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding AdhanPlayButtonText}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ComboBox Pilihan Suara Adzan -->
                                    <ComboBox ItemsSource="{Binding AvailableAdhanSounds}"
                                              SelectedValue="{Binding SelectedAdhanSound, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              Padding="8,5" Margin="0,0,0,6">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" FontSize="12"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource ThemeText}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" Margin="20,1,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <!-- Deskripsi Pilihan Saat Ini -->
                                    <TextBlock Text="{Binding SelectedAdhanDescription}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10.5" Margin="2,0,0,6" TextWrapping="Wrap"/>

                                    <!-- Opsi File Kustom (jika pilih custom) -->
                                    <Grid Visibility="{Binding IsCustomAdhanSelected, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding CustomAdhanSoundPath, Mode=TwoWay}"
                                                 Background="{DynamicResource ThemeSurfaceDeep}" Foreground="{DynamicResource ThemeTextBody}" BorderBrush="{DynamicResource ThemeLineStrong}" Padding="6,4"
                                                 FontSize="11" IsReadOnly="True" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Command="{Binding BrowseCustomAdhanCommand}"
                                                Content="📁 Telusuri..." Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}"
                                                BorderThickness="0" Padding="10,4" Margin="6,0,0,0" Cursor="Hand" FontSize="11"/>
                                    </Grid>

                                    <!-- Volume Slider -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Volume Suara:" Foreground="{DynamicResource ThemeTextBody}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding AdhanVolume, Mode=TwoWay}"
                                                SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding AdhanVolumePercentText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" 
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource ThemeSurfaceRaised}" Margin="0,10,0,10"/>

                                    <!-- Pengaturan Durasi Adzan Pendek (Start - End Time) -->
                                    <StackPanel>
                                        <CheckBox Content="Batasi / potong durasi adzan (buat adzan pendek)"
                                                  IsChecked="{Binding AdhanCustomDurationEnabled, Mode=TwoWay}"
                                                  FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBlock Text="Atur agar adzan diputar lebih pendek sesuai rentang menit dan detik yang Anda tentukan." 
                                                   FontSize="10.5" Foreground="{DynamicResource ThemeTextMuted}" Margin="22,0,0,6" TextWrapping="Wrap"/>

                                        <Border Visibility="{Binding AdhanCustomDurationEnabled, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1" CornerRadius="6"
                                                Padding="10,8" Margin="22,0,0,4">
                                            <StackPanel>
                                                <!-- Preset Cepat -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="Pilihan Cepat: " Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <Button Command="{Binding SetAdhanPreset30sCommand}" Content="30 Detik (Takbir)" 
                                                            Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="7,3" Margin="0,0,4,0" Cursor="Hand" FontSize="10.5"/>
                                                    <Button Command="{Binding SetAdhanPreset1mCommand}" Content="1 Menit" 
                                                            Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="7,3" Margin="0,0,4,0" Cursor="Hand" FontSize="10.5"/>
                                                    <Button Command="{Binding SetAdhanPreset2mCommand}" Content="2 Menit" 
                                                            Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeText}" BorderThickness="0" Padding="7,3" Margin="0,0,4,0" Cursor="Hand" FontSize="10.5"/>
                                                    <Button Command="{Binding SetAdhanPresetFullCommand}" Content="Penuh (Full)" 
                                                            Background="{DynamicResource ThemeSurfaceRaised}" Foreground="{DynamicResource ThemeTextSecondary}" BorderThickness="0" Padding="7,3" Cursor="Hand" FontSize="10.5"/>
                                                </StackPanel>

                                                <!-- Input Menit & Detik -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Mulai dari: [mm] : [ss] -->
                                                    <TextBlock Grid.Column="0" Text="Mulai dari: " Foreground="{DynamicResource ThemeTextBody}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox Grid.Column="1" Text="{Binding AdhanStartMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="34" Height="24" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeLineStrong}"
                                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" ToolTip="Menit mulai (0-59)"/>
                                                    
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                                                        <TextBlock Text=":" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                        <TextBox Text="{Binding AdhanStartSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="34" Height="24" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeLineStrong}"
                                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" ToolTip="Detik mulai (0-59)"/>
                                                        <TextBlock Text=" dtk" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                    </StackPanel>

                                                    <!-- Sampai ke: [mm] : [ss] -->
                                                    <TextBlock Grid.Column="4" Text="Sampai ke: " Foreground="{DynamicResource ThemeTextBody}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox Grid.Column="5" Text="{Binding AdhanEndMinutes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="34" Height="24" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeLineStrong}"
                                                             HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" ToolTip="Menit selesai (0-59)"/>
                                                    
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,0,0">
                                                        <TextBlock Text=":" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                        <TextBox Text="{Binding AdhanEndSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="34" Height="24" Background="{DynamicResource ThemeSurface}" Foreground="{DynamicResource ThemeText}" BorderBrush="{DynamicResource ThemeLineStrong}"
                                                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="11" ToolTip="Detik selesai (0-59)"/>
                                                        <TextBlock Text=" dtk" Foreground="{DynamicResource ThemeTextMuted}" FontSize="10" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Ringkasan Durasi -->
                                                <TextBlock Text="{Binding AdhanDurationSummaryText}" Foreground="#4CAF50" FontSize="10.5" FontWeight="Medium" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Kontrol Pemutar Suara Adzan & Pelacak Detik (Audio Timeline & Scrubber) -->
                                        <Border Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLineStrong}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="🎛️ Kontrol Pemutar &amp; Pelacak Detik Suara" FontWeight="Bold" Foreground="{DynamicResource ThemeText}" FontSize="11.5"/>
                                                        <TextBlock Text="{Binding AdhanPlaybackStatusDetail}" Foreground="#8FA3D4" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <!-- Badge Rentang Aktif -->
                                                    <Border Grid.Column="1" Background="{DynamicResource ThemeSurfaceRaised}" BorderBrush="#353D5C" BorderThickness="1" CornerRadius="5" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding AdhanActiveRangeText}" Foreground="#A8C0FF" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>

                                                <!-- Slider Timeline / Posisi Suara -->
                                                <Grid Margin="0,4,0,2">
                                                    <Slider Minimum="0" Maximum="{Binding AdhanTotalDurationSeconds}" Value="{Binding AdhanCurrentPositionSeconds, Mode=TwoWay}"
                                                            SmallChange="1" LargeChange="5" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Label Detik Real-time (Posisi Saat Ini vs Total) -->
                                                <Grid Margin="2,0,2,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="Posisi: " Foreground="{DynamicResource ThemeTextMuted}" FontSize="10"/>
                                                        <TextBlock Text="{Binding AdhanCurrentPositionText}" Foreground="#00E676" FontWeight="Bold" FontSize="11"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="Geser slider untuk melompat ke detik yang diinginkan" HorizontalAlignment="Center" Foreground="{DynamicResource ThemeTextMuted}" FontSize="9.5"/>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <TextBlock Text="Total: " Foreground="{DynamicResource ThemeTextMuted}" FontSize="10"/>
                                                        <TextBlock Text="{Binding AdhanTotalDurationText}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="10.5"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Tombol Aksi Kontrol Pemutar -->
                                                <WrapPanel Orientation="Horizontal">
                                                    <!-- Play / Pause -->
                                                    <Button Command="{Binding ToggleAdhanPlayPauseCommand}" Background="{DynamicResource ThemeSurfaceHigh}" Foreground="{DynamicResource ThemeText}"
                                                            BorderThickness="0" Padding="12,5" Margin="0,0,6,4" Cursor="Hand" FontSize="11">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding AdhanPlayPauseButtonIcon}" Margin="0,0,4,0"/>
                                                            <TextBlock Text="{Binding AdhanPlayPauseButtonTooltip}"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Stop -->
                                                    <Button Command="{Binding StopAdhanPreviewCommand}" Background="{DynamicResource ThemeSurfaceRaised}" Foreground="#FF6B6B"
                                                            BorderThickness="0" Padding="10,5" Margin="0,0,10,4" Cursor="Hand" FontSize="11">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⏹" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Stop"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Quick Mark Start: Jadikan detik ini sebagai Mulai -->
                                                    <Button Command="{Binding SetCurrentAsStartCommand}" Background="{DynamicResource ThemeSurfaceRaised}" Foreground="#80D8FF"
                                                            BorderThickness="0" Padding="9,5" Margin="0,0,6,4" Cursor="Hand" FontSize="10.5"
                                                            ToolTip="Tandai posisi detik yang sedang berbunyi ini sebagai awal mulai azan">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icons:IconPath Kind="MapMarker" Width="12" Height="12" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Set Jadi Detik Mulai"/>
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- Quick Mark End: Jadikan detik ini sebagai Selesai -->
                                                    <Button Command="{Binding SetCurrentAsEndCommand}" Background="{DynamicResource ThemeSurfaceRaised}" Foreground="#FF80AB"
                                                            BorderThickness="0" Padding="9,5" Margin="0,0,4,4" Cursor="Hand" FontSize="10.5"
                                                            ToolTip="Tandai posisi detik yang sedang berbunyi ini sebagai batas akhir selesai azan">
                                                        <StackPanel Orientation="Horizontal">
                                                            <icons:IconPath Kind="MapMarker" Width="12" Height="12" Margin="0,0,4,0"/>
                                                            <TextBlock Text="Set Jadi Detik Selesai"/>
                                                        </StackPanel>
                                                    </Button>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!-- Pratinjau Jadwal Hari Ini -->
                            <Border Background="{DynamicResource ThemeSurfaceDeep}" BorderBrush="{DynamicResource ThemeLine}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="Pratinjau Jadwal Sholat Hari Ini:" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextBody}" FontSize="11.5" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding TodayPrayerSchedule.Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource ThemeSurface}" CornerRadius="5" Padding="7,4" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ThemeTextSecondary}" FontSize="11" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{Binding FormattedTime}" Foreground="{DynamicResource ThemeText}" FontWeight="Bold" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 6. Cuaca & Gempa Bumi (BMKG) -->
                <Border Style="{StaticResource CategoryCard}" Tag="Cuaca &amp; Info">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="&#x1F324; Cuaca &amp; Gempa Bumi (BMKG)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                                <TextBlock Text="Prakiraan cuaca per 3 jam (3 hari) dan info gempa bumi real-time dari data terbuka resmi BMKG" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Aktifkan fitur Cuaca &amp; Gempa Bumi (BMKG)" IsChecked="{Binding EnableBmkg}"/>

                        <StackPanel Visibility="{Binding EnableBmkg, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                            <Border Background="{DynamicResource ThemeSurfaceDeep}" CornerRadius="6" Padding="10,8">
                                <StackPanel>
                                    <CheckBox Content="Tampilkan pill cuaca &amp; gempa di samping logo TAMANOTCH saat idle" 
                                              IsChecked="{Binding ShowWeatherInCompactNotch}"/>
                                    <CheckBox Content="Tampilkan kualitas udara (AQI) di pill cuaca (estimasi model Open-Meteo)"
                                              IsChecked="{Binding ShowAirQualityInIsland}"/>
                                    <CheckBox Content="Ikuti kota Waktu Sholat / deteksi IP otomatis untuk prakiraan cuaca"
                                              IsChecked="{Binding BmkgFollowPrayerCity}"/>
                                    <CheckBox Content="Notifikasi otomatis saat ada gempa bumi baru dari BMKG" 
                                              IsChecked="{Binding BmkgNotifyNewEarthquake}"/>
                                    <CheckBox Content="Peringatan otomatis saat terdeteksi potensi hujan lebat / petir" 
                                              IsChecked="{Binding BmkgNotifyExtremeWeather}"/>
                                    <TextBlock Text="Sumber Data: Badan Meteorologi, Klimatologi, dan Geofisika (BMKG) — data.bmkg.go.id &amp; api.bmkg.go.id"
                                               FontSize="10" Foreground="{DynamicResource ThemeTextMuted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 7. Pemakaian Claude -->
                <Border Style="{StaticResource CategoryCard}" Tag="Cuaca &amp; Info">
                    <StackPanel>
                        <TextBlock Text="&#x23F1; Pemakaian Claude (kuota 5 jam &amp; 7 hari)" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                        <TextBlock Text="Menampilkan sisa kuota paket Claude Pro/Max di jendela sendiri. Membaca token login Claude Code di komputer ini (hanya dibaca) dan memanggil layanan usage Anthropic yang tidak terdokumentasi resmi; penggunaan token di aplikasi pihak ketiga bisa tidak sejalan dengan ketentuan Anthropic. Mati secara bawaan."
                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <CheckBox Content="Aktifkan pemantauan pemakaian Claude" IsChecked="{Binding EnableClaudeUsage}"/>
                        <StackPanel Margin="22,4,0,0" Visibility="{Binding EnableClaudeUsage, Converter={StaticResource BoolToVis}}">
                            <CheckBox Content="Tampilkan lencana 5 jam / 7 hari di baris pill island" IsChecked="{Binding ShowClaudeUsageInIsland}"/>
                            <CheckBox Content="Notifikasi tray saat kuota mencapai tingkat peringatan (75%) atau kritis (90%)" IsChecked="{Binding NotifyClaudeUsage}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="22,4,0,0"
                                    Visibility="{Binding EnableClaudeUsage, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Segarkan setiap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding ClaudeUsageIntervalOptions}" SelectedItem="{Binding ClaudeUsageRefreshMinutes}"
                                      ItemStringFormat="{}{0} menit" Width="110" Height="26"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 8. Sapaan -->
                <Border Style="{StaticResource CategoryCard}" Tag="Umum">
                    <StackPanel>
                        <TextBlock Text="&#x1F44B; Sapaan &quot;Selamat datang kembali&quot;" FontWeight="SemiBold" Foreground="{DynamicResource ThemeText}"/>
                        <TextBlock Text="Setelah tidak ada gerakan mouse/keyboard cukup lama, sapaan singkat tampil di notch begitu Anda mulai memakai komputer lagi."
                                   FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Nama Anda" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding UserDisplayName, UpdateSourceTrigger=LostFocus}" Width="200" Height="26" MaxLength="40"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Content="Tampilkan sapaan setelah idle lama" IsChecked="{Binding EnableWelcomeBack}"/>
                        <StackPanel Orientation="Horizontal" Margin="22,4,0,0"
                                    Visibility="{Binding EnableWelcomeBack, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Dianggap pergi bila idle" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding WelcomeBackIdleOptions}" SelectedItem="{Binding WelcomeBackIdleMinutes}"
                                      ItemStringFormat="{}{0} menit" Width="110" Height="26"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Button Content="Keluar dari TAMANOTCH" Command="{Binding ExitApplicationCommand}"
                    HorizontalAlignment="Left" Background="{DynamicResource ThemeSurface}" Foreground="#FF6B6B" BorderBrush="#552228" BorderThickness="1"
                    Padding="14,6" Cursor="Hand" ToolTip="Tutup dan hentikan aplikasi TAMANOTCH sepenuhnya"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#4CAF50" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button Content="Tutup Pengaturan" Click="CloseButton_Click" Background="#FFFFFF" Foreground="#000000" 
                        FontWeight="SemiBold" BorderThickness="0" Padding="18,6" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
