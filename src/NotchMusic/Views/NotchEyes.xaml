<UserControl x:Class="NotchMusic.Views.NotchEyes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" SnapsToDevicePixels="False">
    <!-- Dua mata menyala di kegelapan: berkedip dan sesekali melirik (animasi diatur di NotchEyes.xaml.cs) -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="40" Height="24">
            <Ellipse Canvas.Left="7" Canvas.Top="5.5" Width="9" Height="13" Fill="#D8F4FF" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#4FC3FF" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="LeftBlink"/>
                        <TranslateTransform x:Name="LeftLook"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Canvas.Left="24" Canvas.Top="5.5" Width="9" Height="13" Fill="#D8F4FF" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Effect>
                    <DropShadowEffect Color="#4FC3FF" BlurRadius="9" ShadowDepth="0" Opacity="0.85"/>
                </Ellipse.Effect>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="RightBlink"/>
                        <TranslateTransform x:Name="RightLook"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
    </Viewbox>
</UserControl>
